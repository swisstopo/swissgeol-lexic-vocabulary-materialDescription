<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Yellow">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Yellow is a warm primary colour. It is the colour of ripe lemon, gold, sulfur, …</skos:definition>
	<skos:example xml:lang="en">Yellow colour is particularly characteristic of some limestones (e.g. Pierre Jaune de Neuchâtel). Among components, yellow colour is typical for native sulfur, as well as gold and pyrite with a metallic luster.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">yellow</skos:prefLabel>
	<skos:prefLabel xml:lang="de">gelb</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">jaune</skos:prefLabel>
	<skos:prefLabel xml:lang="it">giallo</skos:prefLabel>
	<skos:altLabel xml:lang="en">golden</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellowdark"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellowlight"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow2grey"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow2beige"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow2ochre"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow2brown"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow2red"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow2olive"/>
</rdf:Description>

