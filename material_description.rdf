</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Grey">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">grey can be viewed as an intermediate (or composite) colour between black and white</skos:definition>
	<skos:scopeNote xml:lang="en">Grey colour is probably the most frequent background colour for rocks. Its mention is therefore often omitted to focus on the secondary tint that may be apparent and which is then quoted as a basic colour.</skos:scopeNote>
	<skos:example xml:lang="en">Pure grey colour is characteristic of many limestones, concrete, …</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">grey</skos:prefLabel>
	<skos:prefLabel xml:lang="de">grau</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">gris</skos:prefLabel>
	<skos:prefLabel xml:lang="it">grigio</skos:prefLabel>
	<skos:altLabel xml:lang="en">silber</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Grey2black"/>
