<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Corundum">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Corundum is a very hard Aluminium oxide, with red (Ruby, Cr-bearing) and blue (Saphhire, Fe- and Ti-bearing) gem varieties. It is typically found in silica-poor rocks (alkali igneous undersaturated rocks such as Nepheline syenites, contact aureoles in altered aluminous shales, as well as metamorphosed bauxite residual deposits). Also found in sedimentary placer deposits.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">corundum</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Korund</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">corindon</skos:prefLabel>
	<skos:prefLabel xml:lang="it">corindone</skos:prefLabel>
	<skos:notation>Crn</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gemstones"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1136html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Spinel">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Spinel is a Mg-Al oxide, often also containing minor amounts of Chromium, Iron or Vanadium. It is typically found as an accessory mineral in igneous rocks (basalts, peridotites), as well as in marbles and pegmatites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">spinel</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Spinell</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">spinelle</skos:prefLabel>
	<skos:prefLabel xml:lang="it">spinello</skos:prefLabel>
	<skos:notation>Spl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chromite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3729html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Hematite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Hematite is a trivalent Iron oxide. It is typically found in mineralised veins and as in association with clay minerals in ochre residual deposits</skos:definition>
	<skos:definition xml:lang="en">Hematite is a trivalent Iron oxide (red colour in reflected light, opaque in thin-section). It is typically found in mineralised veins and as in association with clay minerals in ochre residual deposits</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">hematite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hämatit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">hématite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ematite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">haematite</skos:hiddenLabel>
	<skos:notation>Hem</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1856html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Magnetite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Magnetite is an important iron ore mineral, steel-gray in colour, typically found as an accessory mineral in igneous rocks. It is also abundant in sedimentary banded iron formations.</skos:definition>
	<skos:definition xml:lang="en">Magnetite is an important iron ore mineral, typically found as an accessory mineral in igneous rocks. It is also abundant in sedimentary banded iron formations.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">magnetite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Magnetit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">magnétite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">magnetite</skos:prefLabel>
	<skos:notation>Mag</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2538html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ilmenite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Ilmenite is an Iron-Titanium oxide (FeTiO3) typically found as an accessory mineral in igneous rocks. Also found in sedimentary placer deposits.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">ilmenite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ilmenit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ilménite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ilmenite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Titaneisen</skos:altLabel>
	<skos:notation>Ilm</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2013html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chromite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chromite is an Iron and Chromium oxide mineral of the Spinel subgroup typically found as cumulate in ultramafic igneous rocks such as peridotites and associated serpentinites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chromite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chromit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chromite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">cromite</skos:prefLabel>
	<skos:notation>Chr</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Spinel"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1036html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Cassiterite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Cassiterite is a hard and dense oxide (and primary ore) of Tin typically found in hydrothermal veins and pegmatites associated with granitic intrusions. Also found (and exploited) in sedimentary placer deposits.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">cassiterite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kassiterir</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">cassitérite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">cassiterite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Cassiterit, Zinnstein</skos:altLabel>
	<skos:notation>Cst</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tinore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-917html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Tinore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">tin ore</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Zinnerz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minérai d'étain</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerale di stagno</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cassiterite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Rutile">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Rutile is an oxide of titanium typically found as an accessory mineral in high-pressure, high-temperature igneous rocks. Also found in sedimentary placer deposits.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">rutile</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rutil</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">rutile</skos:prefLabel>
	<skos:prefLabel xml:lang="it">rutilo</skos:prefLabel>
	<skos:notation>Rt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3486html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Diaspore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Diaspore is an hydrated aluminium oxide, dimorphous with Boehmite, found in bauxite residual deposits and lateritic soils.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">diaspore</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Diaspor</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">diaspore</skos:prefLabel>
	<skos:prefLabel xml:lang="it">diasporo</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">diasporite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Diasporit</skos:hiddenLabel>
	<skos:notation>Dsp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Boehmite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1285html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Boehmite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Boehmite is a brown-coloured hydrated aluminium oxide, dimorphous with Diaspore, found as a major constituent of bauxite residual deposits and lateritic soils.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">boehmite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Boehmit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">boehmite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">boehmite</skos:prefLabel>
	<skos:altLabel xml:lang="en">böhmite</skos:altLabel>
	<skos:altLabel xml:lang="fr">böhmite</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Böhmit</skos:hiddenLabel>
	<skos:notation>Bhm</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminiumore"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Diaspore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-707html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Bauxite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Bauxite is a residual rock (paleosoil) predominantly made of hydrated aluminium oxides (Boehmite) with iron oxides, kaolinite and other impurities.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">bauxite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bauxit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">bauxite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">bauxite</skos:prefLabel>
	<skos:altLabel xml:lang="it">baussite</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminiumore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-575html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Goethite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Goethite is a yellow to brown Iron oxide-hydroxide typically formed as a weathering product of numerous iron-bearing minerals.</skos:definition>
	<skos:definition xml:lang="en">Goethite is an Iron oxide-hydroxide typically formed as a weathering product of numerous iron-bearing minerals.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">goethite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Goethit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">goethite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">goethite</skos:prefLabel>
	<skos:notation>Gth</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1719html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Limonite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Limonite is a generic informal term for unidentified mixtures of hydrated iron oxide (Hematite) and hydroxide (Goethite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">limonite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Limonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">limonite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">limonite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Brauneisenerz</skos:hiddenLabel>
	<skos:notation>Lm</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2402html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/HydroxideMinerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">hydroxide minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hydroxidmineralien</skos:prefLabel>
