	<skos:prefLabel xml:lang="it">minerale di zinco</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sphalerite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pyrite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pyrite is a very common iron sulfide found in a large variety of sedimentary, metamorphic and magmatic rocks. It is stable under conditions of higher temperatures and lower acidity than its orthorhombic polymorph Marcasite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pyrite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pyrit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pyrite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">pirite</skos:prefLabel>
	<skos:altLabel xml:lang="en">fool's gold</skos:altLabel>
	<skos:altLabel xml:lang="de">Schwefelkies</skos:altLabel>
	<skos:altLabel xml:lang="fr">or des fous</skos:altLabel>
	<skos:notation>Py</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Marcasite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3314html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Marcasite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Marcasite is an iron sulfide polymorph to Pyrite. It is typically found replacing organic matter in sedimentary deposits, particularly coal beds.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">marcasite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Markasit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">marcasite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">marcasite</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2571html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ironore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Diverse kinds of minerals are especially rich in iron and can be exploited as ore. Among those we find oxides (Hematite, Magnetite), sufides (Pyrite), carbonates (Siderite, Ankerite), …</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">iron ore</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Eisenerz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minérai de fer</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerale di ferro</skos:prefLabel>
	<skos:altLabel xml:lang="en">iron minerals</skos:altLabel>
	<skos:altLabel xml:lang="de">Eisenmineralien</skos:altLabel>
	<skos:altLabel xml:lang="fr">minéraux de fer</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Marcasite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Hematite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magnetite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Goethite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Limonite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Siderite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chamosite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Arsenopyrite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Arsenopyrite is an iron-arsenic sulfide mineral. It is typically found in high-temperature gold-quartz or tin hydrothermal veins and pegmatites</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">arsenopyrite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Arsenopyrit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">arsénopyrite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">arsenopirite</skos:prefLabel>
	<skos:altLabel xml:lang="en">arsenical pyrite</skos:altLabel>
	<skos:altLabel xml:lang="de">Misspickel</skos:altLabel>
	<skos:notation>Apy</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-305html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chalcopyrite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chalcopyrite is a sulfide of Copper and Iron typically found in basic magmatic rocks (gabbro, trachite-andesite), as well as in associated mineralised veins (often together with Sphalerite, Pyrite and Galena).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chalcopyrite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chalkopyrit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chalcopyrite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">calcopirite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Kupferkies</skos:altLabel>
	<skos:notation>Ccp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Copperore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-955html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Halideminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Halide designates a mineral family comprising fluoride, chloride, bromide and iodide compounds.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
