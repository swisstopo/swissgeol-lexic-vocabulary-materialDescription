</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Aluminumore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">aluminium ore</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aluminiumerz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minérai d'aluminium</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerale di alluminio</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentbiogenic">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Biogenic components encompass trace fossils, body fossils and fossil fragments (bioclasts), as well as a number of bioconstructions (reef, …).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">biogenic components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">biogene Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">composants biogéniques</skos:prefLabel>
	<skos:prefLabel xml:lang="it">componenti biogenici</skos:prefLabel>
	<skos:altLabel xml:lang="fr">composants biodérivés</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/ComponentNature"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentorganic"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fossiltraces"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fossilparts"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentorganic">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Organic components refer to chemical compounds produced by living organisms and built around carbon backbones that typically bond with hydrogen, oxygen, and nitrogen.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">organic components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">organische Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">composants organiques</skos:prefLabel>
	<skos:prefLabel xml:lang="it">componenti organici</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentbiogenic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Fossiltraces">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Trace fossils refer to a variety of structures and imprints in the geological record that witness of past biological activity. These comprise, among others, burrows, borings, footprints, feeding marks and root cavities.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">ichnofossils</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ichnofossilien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ichnofossiles</skos:prefLabel>
	<skos:prefLabel xml:lang="it">icnofossili</skos:prefLabel>
	<skos:altLabel xml:lang="en">trace fossils</skos:altLabel>
	<skos:altLabel xml:lang="de">Spurenfossilien</skos:altLabel>
	<skos:altLabel xml:lang="fr">traces fossiles</skos:altLabel>
	<skos:altLabel xml:lang="it">traacce fossile</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentbiogenic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Fossilparts">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Body fossils refer to the fossilized remains of whole or fragmented organisms, usually altered by later chemical activity or by mineralization. Biomineralised parts (shells, teeth and bones) are most prone to fossilisation.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">body fossils and bioclasts</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Fossilien und Bioklasten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">fossiles et bioclastes</skos:prefLabel>
	<skos:prefLabel xml:lang="it">fossili e bioclasti</skos:prefLabel>
	<skos:altLabel xml:lang="fr">composants bioclastiques</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentbiogenic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentlithic">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Lithoclastic components refer to fragments of pre-existing rocks making up sedimentary and volcano-sedimentary rocks. In a broad sens, xenoliths and enclaves found in volcanic and plutonic rocks can also be considered as lithic components.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">lithoclastic components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">lithoklastische Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">composants lithoclastiques</skos:prefLabel>
	<skos:prefLabel xml:lang="it">componenti litoclastici</skos:prefLabel>
	<skos:altLabel xml:lang="en">lithoclasts, lithic components, lithics</skos:altLabel>
	<skos:altLabel xml:lang="de">Lithoklasten</skos:altLabel>
	<skos:altLabel xml:lang="fr">lithoclastes, composants lithiques</skos:altLabel>
	<skos:altLabel xml:lang="it">litoclasti, componenti litici</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/ComponentNature"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Matrix">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The matrix refers to the background material that surrounds the macroscopic components and/or is intercalated between those. It consists of smaller crystals, microscopic grains, or volcanic glass.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">matrix</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Matrix</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">matrice</skos:prefLabel>
	<skos:prefLabel xml:lang="it">matrice</skos:prefLabel>
	<skos:altLabel xml:lang="en">groundmass</skos:altLabel>
	<skos:altLabel xml:lang="de">Grundmasse</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Cement">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The cement is an intergranular crystalline material filling the voids and bonding the components together.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">cement</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Zement</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ciment</skos:prefLabel>
	<skos:prefLabel xml:lang="it">cemento</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componenttexture">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The (microscopic) texture refers to the relative arrangement of petrographic components (grains, minerals) at the microscopic scale (visible only under a microscope).</skos:definition>
	<skos:definition xml:lang="fr">arrangement relatif des composants pétrographiques (grains, minéraux) à l'échelle microscopique (visible seulement au microscope)</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">microscopic texture</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mikroskopische Struktur</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">texture microscopique</skos:prefLabel>
	<skos:prefLabel xml:lang="it">tessitura microscopica</skos:prefLabel>
	<skos:altLabel xml:lang="en">microstructure</skos:altLabel>
	<skos:altLabel xml:lang="fr">microstructure</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialFabric"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentstructure">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The (macroscopic) structure refers to the relative arrangement of petrographic components at the macroscopic scale (visible to the naked eye).</skos:definition>
	<skos:definition xml:lang="fr">arrangement relatif des composants pétrographiques à l'échelle macroscopique (visible à l'œil nu)</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">macroscopic structure</skos:prefLabel>
	<skos:prefLabel xml:lang="de">makroskopische Textur</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">structure macroscopique</skos:prefLabel>
	<skos:prefLabel xml:lang="it">struttua macroscopica</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialFabric"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Porosity">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">percentage of void space in a rock</skos:definition>
	<skos:definition xml:lang="fr">La porosité est la mesure des espaces vides (les pores) dans un matériau, exprimée en pourcentage du volume total. Elle détermine ainsi la quantité de fluides qu'une roche ou un matériau peut contenir, sans toutefois considérer les connexions éventuelles entre les pores qui détermine la perméabilité du matériau (ou son étanchéité).</skos:definition>
	<skos:scopeNote xml:lang="en">a large porosity tends to increase the permeability of the material, as long as voids are connected ; it also increases the sensitivity to frost or humidity</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">porosity</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Porosität</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">porosité</skos:prefLabel>
	<skos:prefLabel xml:lang="it">porosità</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialProperty"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Permeability">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">ease of passage of liquids or gases through the material</skos:definition>
	<skos:definition xml:lang="fr">La perméabilité est la capacité d'un matériau à se laisser traverser par un fluide (liquide ou gaz). Elle dépend notamment de la porosité, mais également de la connection entre les pores.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">permeability</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Permeabilität</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">perméabilité</skos:prefLabel>
	<skos:prefLabel xml:lang="it">permeabilità</skos:prefLabel>
	<skos:altLabel xml:lang="de">Durchlässigkeit</skos:altLabel>
	<skos:altLabel xml:lang="fr">étanchéité</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialProperty"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/MaterialProperty">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Material properties encompass more applied characteristics that result from one of more descriptive parameters. These secondary properties are controlled by the main textural attributes.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:topConceptOf rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">material property</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Materialeigenschaft</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">propriété du matériau</skos:prefLabel>
	<skos:prefLabel xml:lang="it">proprietà del materiale</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Materialdescription"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Porosity"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Permeability"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/MaterialComponents">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The components of geological materials can be of very diverse size, shape and nature, and display a variety of more or less ordered mutual arrangement. Besides macroscopic components, matrix and cement can be further distinguished based on their smaller size and/or different genetic history.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:topConceptOf rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">material components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Materialkomponente</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">composant matériel</skos:prefLabel>
	<skos:prefLabel xml:lang="it">componenti del materiale</skos:prefLabel>
	<skos:altLabel xml:lang="en">components of the material</skos:altLabel>
	<skos:altLabel xml:lang="de">Komponente des Materials</skos:altLabel>
	<skos:altLabel xml:lang="fr">composant du matériau</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Materialdescription"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentsize"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentshape"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Matrix"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cement"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/ComponentNature"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/ComponentNature">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The nature of the components plays a major role in the composition and properties of a material. It also serves as a basis for its naming and classification.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:topConceptOf rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">nature of components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Natur der Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">nature des composants</skos:prefLabel>
	<skos:prefLabel xml:lang="it">natura dei componenti</skos:prefLabel>
	<skos:altLabel xml:lang="en">composition</skos:altLabel>
	<skos:altLabel xml:lang="de">Art der Komponenten</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentbiogenic"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentlithic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/MaterialFabric">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The three-dimensional mutual arrangement encompasses, among other things, the relative abundance (proportion), spatial orientation (ggf. preferred orientation/alignment), packing, size (matrix vs. éléments figurés) and shape of components (in particular the intergranular contacts/cement).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:topConceptOf rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">mutual arrangement of components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mutuale Anordnung der Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">arrangement mutuel des composants</skos:prefLabel>
	<skos:prefLabel xml:lang="it">disposizione mutuale dei componenti</skos:prefLabel>
	<skos:altLabel xml:lang="en">(petro)fabric</skos:altLabel>
	<skos:altLabel xml:lang="de">Gefüge</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Materialdescription"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componenttexture"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentstructure"/>
</rdf:Description>

