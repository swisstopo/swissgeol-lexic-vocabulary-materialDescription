<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Red">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Red is a warm primary colour. It is the colour of fresh blood and ruby gemstone.</skos:definition>
	<skos:example xml:lang="en">Red colour is particularly characteristic of iron-rich residual clay deposits («rusty» patina of laterite, bauxite and siderolitic infillings). Among components, red colour is typical for garnet, ruby, …</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
