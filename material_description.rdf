<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Violet">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Violet can be viewed as an intermediate (or composite) colour between blue and red (whereas violet s.s. is rather on the cold bluish side, purple is on the warm reddish side). It is named after the flower genus Viola.</skos:definition>
	<skos:example xml:lang="en">Violet colour is often found associated with red, green and grey tones in variegated rocks. Among minor components, violet colour is typical for fluorite and amethyst.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">violet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">violett</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">violet</skos:prefLabel>
	<skos:prefLabel xml:lang="it">viola</skos:prefLabel>
	<skos:altLabel xml:lang="en">purple</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violetdark"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violetlight"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet2grey"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet2green"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Violetdark">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">dark violet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">dunkelviolett</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">violet foncé</skos:prefLabel>
	<skos:prefLabel xml:lang="it">viola scuro</skos:prefLabel>
	<skos:altLabel xml:lang="en">dark purple</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Violetlight">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">light violet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">hellviolett</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">violet clair</skos:prefLabel>
	<skos:prefLabel xml:lang="it">viola chiaro</skos:prefLabel>
	<skos:altLabel xml:lang="en">light purple, pale violet</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Violet2grey">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">greyish violet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">grauviolett</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">violet grisâtre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">viola grigiastro</skos:prefLabel>
	<skos:altLabel xml:lang="en">greyish purple</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Violet2green">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">greenish violet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">grünviolett</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">violet verdâtre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">viola verdastro</skos:prefLabel>
	<skos:altLabel xml:lang="en">greenish purple</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Magenta">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Magenta can be viewed as somewhat intermediate between red, pink and purple/violet.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">magenta</skos:prefLabel>
	<skos:prefLabel xml:lang="de">magenta</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">magenta</skos:prefLabel>
	<skos:prefLabel xml:lang="it">magenta</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magentadark"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magentalight"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Magentadark">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">dark magenta</skos:prefLabel>
	<skos:prefLabel xml:lang="de">dunkelmagenta</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">magenta foncé</skos:prefLabel>
	<skos:prefLabel xml:lang="it">magenta scuro</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magenta"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Magentalight">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">light magenta</skos:prefLabel>
	<skos:prefLabel xml:lang="de">hellmagenta</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">magenta clair</skos:prefLabel>
	<skos:prefLabel xml:lang="it">magenta chiaro</skos:prefLabel>
	<skos:altLabel xml:lang="en">pale magenta</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magenta"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pink">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pink is a pale, light red colour usually obtained by mixing red and white. It is the most traditional colour of rose petals (hence its name in French).</skos:definition>
	<skos:example xml:lang="en">Pink colour is particularly characteristic of some granites where the potassium feldspar is coloured in pink.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pink</skos:prefLabel>
	<skos:prefLabel xml:lang="de">rosa</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">rose</skos:prefLabel>
	<skos:prefLabel xml:lang="it">rosa</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pinkdark"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pinklight"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pink2grey"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pinkdark">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">tends towards magenta</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">dark pink</skos:prefLabel>
	<skos:prefLabel xml:lang="de">dunkelrosa</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">rose foncé</skos:prefLabel>
	<skos:prefLabel xml:lang="it">rosa scuro</skos:prefLabel>
	<skos:altLabel xml:lang="fr">rose sombre</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pink"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pinklight">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">light pink</skos:prefLabel>
	<skos:prefLabel xml:lang="de">hellrosa</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">rose clair</skos:prefLabel>
	<skos:prefLabel xml:lang="it">rosa chiaro</skos:prefLabel>
	<skos:altLabel xml:lang="en">pale pink</skos:altLabel>
	<skos:altLabel xml:lang="fr">rose pâle</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pink"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pink2grey">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">greyish pink</skos:prefLabel>
	<skos:prefLabel xml:lang="de">graurosa</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">rose grisâtre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">rosa grigiastro</skos:prefLabel>
	<skos:altLabel xml:lang="fr">rose sale</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pink"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentsize">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">As most geological materials have a more or less heterogeous size distribution of their components, the "grainsize" (of any constitutive elements, such as crystals, clasts or fossils) is to be understood as a generic approximation in terms of a unique modal size-range.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">size of components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Grösse der Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">taille des composants</skos:prefLabel>
	<skos:prefLabel xml:lang="it">dimensioni dei componenti</skos:prefLabel>
	<skos:altLabel xml:lang="en">component size, grainsize</skos:altLabel>
	<skos:altLabel xml:lang="de">Korngrösse</skos:altLabel>
	<skos:altLabel xml:lang="fr">granulométrie</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phaneritic"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aphanitic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Phaneritic">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In phaneritic rocks, the components are visible to the naked eye, i.e. they have a diameter of about 0,1 mm or more.</skos:definition>
	<skos:example xml:lang="en">typical grainsize for most plutonic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">phaneritic</skos:prefLabel>
	<skos:prefLabel xml:lang="de">phaneritisch</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">phanéritique</skos:prefLabel>
	<skos:prefLabel xml:lang="it">faneritico</skos:prefLabel>
	<skos:altLabel xml:lang="en">macrocrystalline</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentsize"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Bouldersized"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cobblesized"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsized"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Bouldersized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Boulder-sized components have a diameter larger than 256 mm, i.e. larger than a human head.</skos:definition>
	<skos:scopeNote xml:lang="en">&gt; 256 mm according to Wentworth and Afnor classifications (200-630 mm = Bo for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">boulder-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit blockiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille d'un bloc</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria a blocchi</skos:prefLabel>
	<skos:altLabel xml:lang="en">block-sized</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie blocailleuse</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phaneritic"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Bouldersizedc"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Bouldersizedc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Coarse boulder-sized components have a diameter larger than 630 mm, i.e. mostly in the metric range and larger.</skos:definition>
	<skos:scopeNote xml:lang="en">&gt; 630 mm = lBo for soils according to ISO 14688-1</skos:scopeNote>
	<skos:example xml:lang="en">megabreccia</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">coarse boulder-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit grober blockiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille d'un gros bloc</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria a blocchi grossolani</skos:prefLabel>
	<skos:altLabel xml:lang="en">megablock-sized</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie blocailleuse grossière</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Bouldersized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Cobblesized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Cobble-sized components have a diameter of 64 to 256 mm, i.e. larger than an egg or fist.</skos:definition>
	<skos:definition xml:lang="de">typische Korngrösse von Gerölle, Geschiebe, Schutt, Grobstein</skos:definition>
	<skos:scopeNote xml:lang="en">64-256 mm according to Wentworth and Afnor classifications (63-200 mm = Co for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">cobble-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit steiniger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille d'un (gros) caillou</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sassosa</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie caillouteuse</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phaneritic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gravelsized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Gravel-sized components have a diameter of 2 to 64 mm, i.e. in the millimetric to centimetric range.</skos:definition>
	<skos:scopeNote xml:lang="en">2-64 mm according to Wentworth and Afnor classifications (2-63 mm = Gr for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for conglomerate and breccia, as well as (very) coarse-grained plutonic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">gravel-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit kiesiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du gravier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria ghiaiosa</skos:prefLabel>
	<skos:altLabel xml:lang="en">pebble-sized, of psephitic size, of ruditic size</skos:altLabel>
	<skos:altLabel xml:lang="de">mit psephitischer Korngrösse</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie graveleuse, de la taille d'un petit caillou, de granulométrie pséphitique, de granulométrie ruditique</skos:altLabel>
	<skos:altLabel xml:lang="it">di granulometria psefitica, di granulometria ruditica</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phaneritic"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsizedvc"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsizedc"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsizedm"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsizedf"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsizedvf"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gravelsizedvc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Very coarse gravel-sized components have a diameter of 32 to 64 mm, i.e. in the centimetric range.</skos:definition>
	<skos:definition xml:lang="de">typische Korngrösse von Grobkies, Mittelstein, Schotter</skos:definition>
	<skos:scopeNote xml:lang="en">32-64 mm according to Wentworth and Afnor classifications (20-63 mm = cGr for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for very coarse-grained plutonic rocks (e.g. pegmatite)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">very coarse gravel-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit sehr grober kiesiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du gravier très grossier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria ghiaiosa molto grossolana</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie graveleuse très grossière, de la taille d'une grave grossière</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gravelsizedc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Coarse gravel-sized components have a diameter of 16 to 32 mm, i.e. about the size of a hazelnut or nutshell.</skos:definition>
	<skos:definition xml:lang="de">maximale Korngrösse von Mittelkies, Feinstein, Splitt</skos:definition>
	<skos:scopeNote xml:lang="en">16-32 mm according to Wentworth and Afnor classifications (6,3-20 mm = mGr for soils according to ISO 14688-1, i.e. medium to coarse not differentiated)</skos:scopeNote>
	<skos:example xml:lang="en">maximal grainsize for coarse-grained plutonic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">coarse gravel-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit grober kiesiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du gravier grossier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria ghiaiosa grossolana</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie graveleuse grossière</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gravelsizedm">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Medium gravel-sized components have a diameter of 8 to 16 mm, i.e. around one centimeter.</skos:definition>
	<skos:definition xml:lang="de">minimale Korngrösse von Mittelkies, Feinstein, Splitt</skos:definition>
	<skos:scopeNote xml:lang="en">8-16 mm according to Wentworth and Afnor classifications (6,3-20 mm = mGr for soils according to ISO 14688-1, i.e. medium to coarse not differentiated)</skos:scopeNote>
	<skos:example xml:lang="en">minimal grainsize for coarse-grained plutonic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">medium gravel-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit mittlerer kiesiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du gravier moyen</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria ghiaiosa media</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie graveleuse moyenne</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gravelsizedf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Fine gravel-sized components have a diameter of 4 to 8 mm, i.e. slightly larger than a pea.</skos:definition>
	<skos:definition xml:lang="de">maximale Korngrösse von Feinkies, Grus</skos:definition>
	<skos:scopeNote xml:lang="en">4-8 mm according to Wentworth and Afnor classifications (2,0-6,3 mm = fGr for soils according to ISO 14688-1, i.e. fine to very fine not differentiated)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for medium-grained plutonic rocks (e.g. granite)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">fine gravel-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit feiner kiesiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du gravier fin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria ghiaiosa fine</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie graveleuse fine</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gravelsizedvf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Very fine gravel-sized components have a diameter of 2 to 4 mm, i.e. about the size of a pea or slightly smaller.</skos:definition>
	<skos:definition xml:lang="de">minimale Korngrösse von Feinkies, Grus</skos:definition>
	<skos:scopeNote xml:lang="en">2-4 mm according to Wentworth and Afnor classifications (2,0-6,3 mm = fGr for soils according to ISO 14688-1, i.e. fine to very fine not differentiated)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for fine-grained plutonic rocks (e.g. microgranite), as well as maximal grainsize for phenocrysts of most volcanic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">very fine gravel-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit sehr feiner kiesiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du gravier très fin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria ghiaiosa molto fine</skos:prefLabel>
	<skos:altLabel xml:lang="en">granule-sized</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie graveleuse très fine, de la taille du granulé</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gravelsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sandsized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sand-sized components have a diameter of 0.0625 to 2,0 mm, i.e. mostly smaller than a millimeter but still visible to the naked eye.</skos:definition>
	<skos:scopeNote xml:lang="en">1/16-2 mm according to Wentworth and Afnor classifications (0,063-2,0 mm = Sa for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for sandstone and calcarenite, minimal grainsize for fine-grained plutonic rocks, maximal grainsize of volcanic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sand-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit sandiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du sable</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sabbiosa</skos:prefLabel>
	<skos:altLabel xml:lang="en">of psammitic size, of arenitic size</skos:altLabel>
	<skos:altLabel xml:lang="de">mit psammitischer Korngrösse</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie sableuse, de granulométrie psammitique, de granulométrie arénitique</skos:altLabel>
	<skos:altLabel xml:lang="it">di granulometria psammitica, di granulometria arenitica</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phaneritic"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsizedvc"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsizedc"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsizedm"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsizedf"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsizedvf"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sandsizedvc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Very coarse sand-sized components have a diameter of 1 to 2 mm, i.e. around one millimeter.</skos:definition>
	<skos:definition xml:lang="de">maximale Korngrösse von Grobsand</skos:definition>
	<skos:scopeNote xml:lang="en">1-2 mm according to Wentworth and Afnor classifications (0,63-2,0 mm = cSa for soils according to ISO 14688-1, i.e. coarse to very coarse not differentiated)</skos:scopeNote>
	<skos:example xml:lang="en">maximal grainsize for aplite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">very coarse sand-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit sehr grober sandiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du sable très grossier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sabbiosa molto grossolana</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie sableuse très grossière</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sandsizedc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Coarse sand-sized components have a diameter of 0,5 to 1,0 mm, i.e. slightly smaller than a millimeter.</skos:definition>
	<skos:definition xml:lang="de">minimale Korngrösse von Grobsand</skos:definition>
	<skos:scopeNote xml:lang="en">0.5-1 mm according to Wentworth and Afnor classifications (0,63-2,0 mm = cSa for soils according to ISO 14688-1, i.e. coarse to very coarse not differentiated)</skos:scopeNote>
	<skos:example xml:lang="en">minimal grainsize for aplite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">coarse sand-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit grober sandiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du sable grossier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sabbiosa grossolana</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie sableuse grossière</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sandsizedm">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Medium sand-sized components have a diameter of 0,25 to 0,5 mm, i.e. about the size of grit or semolina.</skos:definition>
	<skos:definition xml:lang="de">typische Korngrösse von Mittelsand</skos:definition>
	<skos:scopeNote xml:lang="en">0.25-0.5 mm according to Wentworth and Afnor classifications (0,2-0,63 mm = mSa for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">medium sand-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit mittlerer sandiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du sable moyen</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sabbiosa media</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie sableuse moyenne</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sandsizedf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Fine sand-sized components have a diameter of 0,125 to 0,25 mm, i.e. about the size of coarse flower (still visible to the naked eye).</skos:definition>
	<skos:definition xml:lang="de">maximale Korngrösse von Feinsand</skos:definition>
	<skos:scopeNote xml:lang="en">0.125-0.25 mm according to Wentworth and Afnor classifications (0,063-0,2 mm = fSa for soils according to ISO 14688-1, i.e. fine to very fine not differentiated)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">fine sand-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit feiner sandiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du sable fin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sabbiosa fine</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie sableuse fine, de granulométrie sabloneuse, de la taille du sablon</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sandsizedvf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Very fine sand-sized components have a diameter of 0,0625 to 0,125 mm, i.e. about the size of fine flower (only visible with a magnifying glass).</skos:definition>
	<skos:definition xml:lang="de">minimale Korngrösse von Feinsand</skos:definition>
	<skos:scopeNote xml:lang="en">1/16-0.125 mm according to Wentworth and Afnor classifications (0,063-0,2 mm = fSa for soils according to ISO 14688-1, i.e. fine to very fine not differentiated)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">very fine sand-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit sehr feiner sandiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du sable très fin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria sabbiosa molto fine</skos:prefLabel>
	<skos:altLabel xml:lang="fr">de granulométrie sableuse très fine</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Aphanitic">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In aphanitic rocks, the components are not identifiable to the naked eye, i.e. they are mostly smaller than 0,1 mm in diameter.</skos:definition>
	<skos:example xml:lang="en">typical grainsize for pelitic rocks, as well as volcanic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">aphanitic</skos:prefLabel>
	<skos:prefLabel xml:lang="de">aphanitisch</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">aphanitique</skos:prefLabel>
	<skos:prefLabel xml:lang="it">afanitico</skos:prefLabel>
	<skos:altLabel xml:lang="en">of pelitic size, of lutitic size</skos:altLabel>
	<skos:altLabel xml:lang="de">mit pelitischer Korngrösse, mit lutitischer Korngrösse</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie pélitique, de granulométrie lutitique</skos:altLabel>
	<skos:altLabel xml:lang="it">di granulometria pelitica, di granulometria lutitica</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sandsized"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Microcrystalline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Siltsized"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cryptocrystalline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Claysized"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colloidsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Microcrystalline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In microcrystalline rocks, the components have a diameter of about 0,1 mm or slightly less, i.e. they are just perceptible with a magnifying glass.</skos:definition>
	<skos:example xml:lang="en">typical grainsize for most volcanic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">microcrystalline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mikrokristallin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">microcristallin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">microcristallino</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aphanitic"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Siltsized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Siltsized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Silt-sized components have a diameter of about 4 to 62 micrometers, i.e. not visible with a magnifying glass but still perceptible under the teeth and non-cohesive.</skos:definition>
	<skos:definition xml:lang="de">typische Korngrösse von Schluff, Pelit, Gesteinsmehl, Mehlkorn</skos:definition>
	<skos:scopeNote xml:lang="en">1/256-1/16 mm according to Wentworth and Afnor classifications (0,002-0,063 mm = Si for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for siltstone and calcilutite, as well as most volcanic rocks</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">silt-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit siltiger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille du limon</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria siltosa</skos:prefLabel>
	<skos:altLabel xml:lang="de">mit lehmiger Korngrösse</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie limoneuse, de granulométrie silteuse, de la taille du silt</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aphanitic"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Microcrystalline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Cryptocrystalline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In cryptocrystalline rocks, components have a diameter smaller than 4 micrometer.</skos:definition>
	<skos:example xml:lang="en">typical of volcanic glass</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">cryptocrystalline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">cryptokristallin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">cryptocristallin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">criptocristallino</skos:prefLabel>
	<skos:altLabel xml:lang="en">glassy</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aphanitic"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Claysized"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Claysized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Clay-sized components have a diameter smaller than about 4 micrometer, i.e. neither visible with a magnifying glass, nor perceptible under the teeth, but usually intrinsically cohesive.</skos:definition>
	<skos:scopeNote xml:lang="en">&lt; 1/256 mm according to Wentworth and Afnor classifications (&lt; 0,002 mm = Cl for soils according to ISO 14688-1)</skos:scopeNote>
	<skos:example xml:lang="en">typical grainsize for claystone</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">clay-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit toniger Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille de l'argile</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria argillosa</skos:prefLabel>
	<skos:altLabel xml:lang="en">mud-sized</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie argileuse</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aphanitic"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cryptocrystalline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Colloidsized">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Colloid-sized components have a diameter smaller than about 1 micrometer, i.e. not settling down in water due to surface tension forces.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">colloid-sized</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mit kolloidaler Korngrösse</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">de la taille des colloïdes</skos:prefLabel>
	<skos:prefLabel xml:lang="it">di granulometria colloidale</skos:prefLabel>
	<skos:altLabel xml:lang="en">colloidal</skos:altLabel>
	<skos:altLabel xml:lang="fr">de granulométrie colloïdale</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aphanitic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentshape">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The shape of components can be described in terms of relative proportions (in 2D section or as 3D body) or in qualitative comparison with common forms. The degree of rounding is described separately due to its particular interpretative significanace.</skos:definition>
	<skos:scopeNote xml:lang="en">habit = general appearance, crystalline growth style ; form = specific geometric arrangement of crsytal faces ; system (symmetry, lattice parameters)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">shape of components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Form der Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">forme des composants</skos:prefLabel>
	<skos:prefLabel xml:lang="it">forma dei componenti</skos:prefLabel>
	<skos:altLabel xml:lang="en">component shape, form, habit</skos:altLabel>
	<skos:altLabel xml:lang="fr">habitus</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Componentangularity">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The roundness (or inversely the angularity) indicates the degree of smoothing of particles, i.e. the shape of their corners. Although mathematically quantifiable, geologists use in their praxis a simple visual chart for qualitative comparisons.</skos:definition>
	<skos:definition xml:lang="fr">Le degré d'arrondi (ou inversément d'angularité) sert à décrire dans quelle mesure les angles d'une particule sont émoussés (p.ex. lissage du à l'abrasion). Bien qu'une quantification mathématique soit possible, on utilise généralement dans la pratique une charte visuelle simple à des fins de comparaison qualitative.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">angularity of components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kantigkeit der Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">angularité des composants</skos:prefLabel>
	<skos:prefLabel xml:lang="it">angolarità dei componenti</skos:prefLabel>
	<skos:altLabel xml:lang="en">component angularity, roundness grade, rounding</skos:altLabel>
	<skos:altLabel xml:lang="de">Abrundung der Komponenten</skos:altLabel>
	<skos:altLabel xml:lang="fr">angulosité, émoussé, arrondi</skos:altLabel>
	<skos:altLabel xml:lang="it">arrontondamento dei componenti</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Shapeveryangular"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Shapeangular"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Shapesubangular"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Shapesubrounded"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Shaperounded"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Shapeveryrounded"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentshape"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Shapeveryangular">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A very angular component displays sharp corners and jagged edges.</skos:definition>
	<skos:definition xml:lang="fr">coins pointus et irréguliers</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">very angular</skos:prefLabel>
	<skos:prefLabel xml:lang="de">scharfkantig</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">très anguleux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">a bordi affilati</skos:prefLabel>
	<skos:altLabel xml:lang="de">sehr kantig</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Shapeangular">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An angular component displays angular corners and irregular edges with concave sectors.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">angular</skos:prefLabel>
	<skos:prefLabel xml:lang="de">kantig</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">anguleux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">spigoloso</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Shapesubangular">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A sub-angular component displays corners that are only slightly rounded and irregularly smoothed edges.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sub-angular</skos:prefLabel>
	<skos:prefLabel xml:lang="de">kantengerundet</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">subanguleux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">a bordi arrotondati</skos:prefLabel>
	<skos:altLabel xml:lang="de">sub-kantig</skos:altLabel>
	<skos:altLabel xml:lang="fr">sub-anguleux</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Shapesubrounded">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A sub-rounded component displays blunt corners and regularly smoothed edges.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sub-rounded</skos:prefLabel>
	<skos:prefLabel xml:lang="de">angerundet</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">subarrondi</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sub-arrotondato</skos:prefLabel>
	<skos:altLabel xml:lang="de">sub-gerundet</skos:altLabel>
	<skos:altLabel xml:lang="fr">sub-arrondi, subémoussé, sub-émoussé</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Shaperounded">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A rounded component displays rounded corners and edges that are still perceptible though largely smoothed.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">rounded</skos:prefLabel>
	<skos:prefLabel xml:lang="de">gerundet</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">arrondi</skos:prefLabel>
	<skos:prefLabel xml:lang="it">arrotondato</skos:prefLabel>
	<skos:altLabel xml:lang="fr">arrondi</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Shapeveryrounded">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A well rounded component displays complety rounded corners and no visible edges (overall shape ovoidal to spherical).</skos:definition>
	<skos:definition xml:lang="fr">coins complètement arrondis</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">well rounded</skos:prefLabel>
	<skos:prefLabel xml:lang="de">gut gerundet</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">bien arrondi [très arrondi]</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ben arrotondato</skos:prefLabel>
	<skos:altLabel xml:lang="de">sehr gerundet</skos:altLabel>
	<skos:altLabel xml:lang="fr">très émoussé</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Componentangularity"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Minerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Mineral components refer to naturally occurring, inorganic solids with a specific chemical composition and orderly internal crystal structure.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">mineral components</skos:prefLabel>
	<skos:prefLabel xml:lang="de">mineralogische Komponenten</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">composants minéraux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">componenti minerali</skos:prefLabel>
	<skos:altLabel xml:lang="en">minerals</skos:altLabel>
	<skos:altLabel xml:lang="de">Mineralkomponenten, Mineralien</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/ComponentNature"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativeelements"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gemstones"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Halideminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phosphateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nativeelements">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Native Elements occur uncombined to other chemical elements.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">native elements</skos:prefLabel>
	<skos:prefLabel xml:lang="de">natives Element</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">éléments natifs</skos:prefLabel>
	<skos:prefLabel xml:lang="it">elementi nativi</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativegold"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativesilver"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativecopper"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativesulfur"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nativegold">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Gold only occurs in a pure metallic form. It is found either in hydrothermal quartz veins or in sedimentary placer deposits (as "paillettes" or gold nuggets).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">native gold</skos:prefLabel>
	<skos:prefLabel xml:lang="de">natives Gold</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">or natif</skos:prefLabel>
	<skos:prefLabel xml:lang="it">oro nativo</skos:prefLabel>
	<skos:notation>Au</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativeelements"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1720html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nativesilver">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Silver is primarily found in hydrothermal veins, often associated with copper or Galena.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">native silver</skos:prefLabel>
	<skos:prefLabel xml:lang="de">natives Silber</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">argent natif</skos:prefLabel>
	<skos:prefLabel xml:lang="it">argento nativo</skos:prefLabel>
	<skos:notation>Ag</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativeelements"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3664html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nativecopper">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Native Copper is the pure metallic form of Copper.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">native copper</skos:prefLabel>
	<skos:prefLabel xml:lang="de">natives Kupfer</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">cuivre natif</skos:prefLabel>
	<skos:prefLabel xml:lang="it">rame nativo</skos:prefLabel>
	<skos:notation>Cu</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativeelements"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1209html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nativecarbon">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Ath the Earth surface, unbound Native Carbon occurs mostly as Graphite, with Diamond representing a high-pressure form only found in rare situations.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">native carbon</skos:prefLabel>
	<skos:prefLabel xml:lang="de">natives Karbon</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">carbone natif</skos:prefLabel>
	<skos:prefLabel xml:lang="it">carbone nativo</skos:prefLabel>
	<skos:notation>C</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Copperore"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Diamond"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Graphite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Copperore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">copper ore</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kupfererz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minérai de cuivre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerale di rame</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativecarbon"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chalcopyrite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Diamond">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Diamond is a high-pressure native carbon mineral typically found in deep mantle-derived rocks such as kimberlites and lamprophyres. It is the hardest mineral known with a high refractive index, which makes it a valuable gemstone.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">diamond</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Diamant</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">diamant</skos:prefLabel>
	<skos:prefLabel xml:lang="it">diamante</skos:prefLabel>
	<skos:notation>Dia</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativecarbon"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gemstones"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1282html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Industrialminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">industrial minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Industriemineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minéraux industriel</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerali industrial</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Diamond"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Graphite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Halite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fluorite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Corundum"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Calcite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gypsum"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Kaolinite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Talc"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Asbestos"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gemstones">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">gemstones</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Edelsteine</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">gemmes</skos:prefLabel>
	<skos:prefLabel xml:lang="it">gemme</skos:prefLabel>
	<skos:altLabel xml:lang="en">gems</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Diamond"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Corundum"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Beryl"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tourmaline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Graphite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Graphite is a form of native carbon typically found in in metamorphosed carbon-rich rocks.</skos:definition>
	<skos:example xml:lang="en">Graphitschiefer, schiste graphiteux</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">graphite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Graphit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">graphite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">grafite</skos:prefLabel>
	<skos:notation>Gr</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativecarbon"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1740html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nativesulfur">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Native Sulfur is typically deposited from volcanic gases (associated with realgar, cinnabar and other minerals). It is also found in some vein deposits and as an alteration product of sulphide minerals.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">native sulfur</skos:prefLabel>
	<skos:prefLabel xml:lang="de">natives Sulfur</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">soufre natif</skos:prefLabel>
	<skos:prefLabel xml:lang="it">zolfo nativo</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nativeelements"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3826html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sulfide minerals are formed by the linkage of sulphur with a metal or semimetal (e.g. Galena, Pyrite, …).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sulfide minerals [US]</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sulfidmineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sulfures minéraux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">solfuri minerali</skos:prefLabel>
	<skos:altLabel xml:lang="en">sulphide minerals [UK]</skos:altLabel>
	<skos:altLabel xml:lang="fr">sulphures</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Galena"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sphalerite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Marcasite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Arsenopyrite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chalcopyrite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Galena">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Galena is a lead sulfide mineral. It is typically found in ore veins and skarns and serves as primary ore mineral of lead (often associated with minor silver content)</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">galena</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Galenit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">galène</skos:prefLabel>
	<skos:prefLabel xml:lang="it">galena</skos:prefLabel>
	<skos:altLabel xml:lang="en">lead glance</skos:altLabel>
	<skos:altLabel xml:lang="de">Bleiglanz</skos:altLabel>
	<skos:hiddenLabel xml:lang="fr">galénite</skos:hiddenLabel>
	<skos:notation>Gn</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Leadore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1641html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Leadore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="de">Kupfererz</skos:prefLabel>
	<skos:prefLabel xml:lang="en">lead ore</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minérai de plomb</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerale di piombo</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Metallicores"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Galena"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sphalerite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sphalerite (Blende) is a zinc sulfide mineral, often also containing minor amounts of rare metals such as Galium, Indium or Germanium.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sphalerite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sphalerit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sphalérite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sfalerite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Zinkblende</skos:altLabel>
	<skos:altLabel xml:lang="fr">blende</skos:altLabel>
	<skos:notation>Sps</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfideminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Zincore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3727html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Zincore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
