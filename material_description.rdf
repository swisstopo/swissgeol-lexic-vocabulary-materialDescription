	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochre"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ochre2red">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The reddish ochre colour is due to the presence of hematite. Sienna corresponds to a deep red ochre colour.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">reddish ochre</skos:prefLabel>
	<skos:prefLabel xml:lang="de">rotocker</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ocre rougeâtre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ocra rossastro</skos:prefLabel>
	<skos:altLabel xml:lang="en">sienna</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochre"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Brown">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Brown is a composite colour situated on the darker side of the hue spectrum of yellows to reds. It is the colour of wood, coffee, chocolate or organic soil.</skos:definition>
	<skos:example xml:lang="en">Brown colour is particulary characteristic of iron-rich sedimentary rocks («rusty» patina of «Eisensandstein», hard-grounds and residual clay deposits). Among components, brown colour is typical for iron oxide, lignite, …</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">brown</skos:prefLabel>
	<skos:prefLabel xml:lang="de">braun</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">brun</skos:prefLabel>
	<skos:prefLabel xml:lang="it">marrone</skos:prefLabel>
	<skos:altLabel xml:lang="fr">marron</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
