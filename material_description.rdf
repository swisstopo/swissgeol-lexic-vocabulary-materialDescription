<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Green">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Green can be viewed as an intermediate (or composite) colour between yellow and blue. It corresponds to the light wavelength mostly reflected by photosynthetic vegetation.</skos:definition>
	<skos:example xml:lang="en">Green colour is particularly characteristic of greenschists, serpentinites and peridotites, as well as marine detrital rocks rich in glauconite («Grünsandstein»). Among components, green colour is typical for amphiboles, olivines, chlorite, epidote or glauconite.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">green</skos:prefLabel>
	<skos:prefLabel xml:lang="de">grün</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">vert</skos:prefLabel>
	<skos:prefLabel xml:lang="it">verde</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Greendark"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Greenlight"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Green2grey"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Green2yellow"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Green2olive"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Green2blue"/>
</rdf:Description>

