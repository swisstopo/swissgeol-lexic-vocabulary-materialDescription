	<skos:prefLabel xml:lang="it">fluorite</skos:prefLabel>
	<skos:altLabel xml:lang="it">fluorina</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">fluorspar</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Flussspat</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">fluorite, spath fluor</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">spatofluore</skos:hiddenLabel>
	<skos:notation>Fl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Halideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1576html"/>
