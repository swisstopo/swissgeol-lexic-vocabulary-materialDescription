	<skos:prefLabel xml:lang="it">alogenuri minerali</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Halite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fluorite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Halite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Halite is a sodium chloride (NaCl) mineral constituting evaporitic rock salt.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">halite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Halit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">halite</skos:prefLabel>
