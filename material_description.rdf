<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Blue">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Blue is a primary colour. It is the typical colour of clear sky or the ocean.</skos:definition>
	<skos:example xml:lang="en">Blue colour is particularly characteristic of blueschists. Among components, blue colour is typical for glaucophane and kyanite.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">blue</skos:prefLabel>
