<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Beige">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Beige is a pale colour mixing/spanning tints of very light brown to ochre, yellowish, creamy white and greyish. The name originally refers to the natural colour of wool.</skos:definition>
	<skos:scopeNote xml:lang="en">ranges between yellowish (creamy) white and pale brown</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">beige</skos:prefLabel>
