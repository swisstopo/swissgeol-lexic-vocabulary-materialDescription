<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Olive">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Olive is an earthy colour somewhat intermediate between green and brown. It is named after the appearance of unripened, green olives.</skos:definition>
