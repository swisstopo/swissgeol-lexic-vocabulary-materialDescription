<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ochre">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Ochre is a warm colour mixing/spanning tints of yellow, orange, reddish and brownish, that also has a broad spectrum of shades (from beige to golden or safran yellow and dark reddish brown). It is a widely used earthy pigment containing clays and ferric oxides (yellow goethite and red hematite).</skos:definition>
	<skos:scopeNote xml:lang="en">ranges between yellow, orange and brown</skos:scopeNote>
	<skos:example xml:lang="en">Ochre colour is particularly characteristic of residual clay deposits containing small amounts of iron oxides («rusty» patina with hematite or limonite).</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">ochre</skos:prefLabel>
	<skos:prefLabel xml:lang="de">ocker</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ocre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ocra</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochredark"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochrelight"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochre2red"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ochredark">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Dark ochre tends towards chestnut brown.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">dark ochre</skos:prefLabel>
	<skos:prefLabel xml:lang="de">dunkelocker</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ocre foncé</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ocra scuro</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochre"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ochrelight">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Light ochre tends towards golden or safran yellow.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">light ochre</skos:prefLabel>
