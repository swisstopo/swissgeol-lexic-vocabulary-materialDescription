	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oxidehydroxideminerals"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gibbsite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Gibbsite is an Aluminium hydroxide typically found as an alteration product in lateritic soils and bauxite residual deposits.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">gibbsite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Gibbsit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">gibbsite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">gibbsite</skos:prefLabel>
	<skos:altLabel xml:lang="en">hydrargillite</skos:altLabel>
	<skos:altLabel xml:lang="de">Hydrargillit</skos:altLabel>
	<skos:altLabel xml:lang="it">idrargillite</skos:altLabel>
	<skos:notation>Gbs</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminiumore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Hydroxideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1689html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Carbonates are a common and widespread mineral group (with Calcite, Aragonite and Dolomite as most abundant representatives). They are typical rock-forming minerals of sedimentary rocks (in particular limestone and dolostone, but also as components of clastic rocks) and their metamorphosed counterparts (marbles).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">carbonate minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Karbonatmineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">carbonates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">carbonati</skos:prefLabel>
	<skos:altLabel xml:lang="en">carbonate mineral group</skos:altLabel>
	<skos:altLabel xml:lang="de">Karbonatgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des carbonates</skos:altLabel>
	<skos:notation>Cb</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Calcite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aragonite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Dolomite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ankerite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magnesite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Siderite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-47872html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Calcite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Calcite is the stable and most widespread form of calcium carbonate.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">calcite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Calcit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">calcite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">calcite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Kalzit</skos:hiddenLabel>
	<skos:notation>Cal</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aragonite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-859html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Aragonite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Aragonite is a calcium carbonate mineral (the second most common polymorph after Calcite). It is metastable relative to Calcite and therefore nearly always a low-temperature, near-surface mineral (speleothems in limestone caves, spring deposits, shell material, pisolites).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">aragonite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aragonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">aragonite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">aragonite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Aragon Spar</skos:altLabel>
	<skos:notation>Arg</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Calcite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-307html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Dolomite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Dolomite is a common rock forming Calcium-Magnesium carbonate mineral. It can form by direct precipitation (in evaporitic environments, often micritic, i.e. fined-grained) or as secondary replacement of calcite (dolomitisation, often coarser-grained or saccharoidal).</skos:definition>
	<skos:example xml:lang="en">Dolomitstein</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">dolomite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Dolomit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">dolomite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">dolomite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">dolomie</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">dolomia</skos:hiddenLabel>
	<skos:notation>Dol</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1304html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ankerite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Ankerite is a brownish iron-rich (Fe&gt;Mg) calcium-magnesium carbonate forming a continuous series with Dolomite. Actually, most citations are probably rather Fe-rich Dolomite according to the current classification. It is typically found in low-grade metamorphosed ironstones.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">ankerite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ankerit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ankérite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ankerite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">brown spar</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Braunspat</skos:hiddenLabel>
	<skos:notation>Ank</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Dolomite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-239html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Magnesite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Magnesite is a Mg-rich carbonate mineral forming a series with its Fe-rich counterpart Siderite. It is typically found as a metamorphic product of serpentinites and peridotites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">magnesite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Magnesit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">magnésite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">magnesite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Bitterspat</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">spato amaro</skos:hiddenLabel>
	<skos:notation>Mgs</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Siderite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2482html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Siderite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Siderite is an iron carbonate mineral tpically found in C-rich pelitic rocks, as well as in their metamorphic equivalents.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">siderite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Siderit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sidérite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">siderite</skos:prefLabel>
	<skos:notation>Sd</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carbonateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magnesite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3647html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sulfateminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sulphates minerals are based on SO4-anions.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sulfate minerals [US]</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sulfatmineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sulfates minéraux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sulfati minerali</skos:prefLabel>
	<skos:altLabel xml:lang="en">sulphate minerals [UK]</skos:altLabel>
	<skos:altLabel xml:lang="fr">minéraux sulfatés, sulphates</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Anhydrite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gypsum"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Baryte"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Celestine"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Anhydrite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Anhydrite is an anhydrous calcium sulfate mineral. It forms as a sedimentary evaporitic deposit and readily alters to Gypsum.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">anhydrite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Anhydrit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">anhydrite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">anidrite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">karsténite</skos:altLabel>
	<skos:notation>Anh</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gypsum"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-234html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Gypsum">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Gypsum is an hydrated calcium sulfate typically found in marine evaporites.
Synonyms of Gypsum</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">gypsum</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Gips</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">gypse</skos:prefLabel>
	<skos:prefLabel xml:lang="it">gesso</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Gipsspat</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">sélénite</skos:hiddenLabel>
	<skos:notation>Gp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Anhydrite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1784html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Baryte">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Baryte is a very dense barium sulfate mineral forming a series with Celestine. It is typically found as an epithermal or mesothermal gangue mineral with associated metallic ore deposits. Also found as cement or nodules (concretions with fibrous internal structure) in sedimentary rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">baryte</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Baryt</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">barytine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">barite</skos:prefLabel>
	<skos:altLabel xml:lang="en">barite</skos:altLabel>
	<skos:altLabel xml:lang="fr">baryte, barytite</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Schwerspat</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">baritina</skos:hiddenLabel>
	<skos:notation>Brt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Celestine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-549html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Celestine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Celestine is a bluish strontium sulfate mineral forming a series with Baryte. It is typically found in association with gypsum and halite, as well as in cavities in limestone and dolostone.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">celestine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Coelestin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">célestine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">celestina</skos:prefLabel>
	<skos:notation>Clt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sulfateminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Baryte"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-927html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Phosphateminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Phosphate minerals are found either as Apatite (an important biogenic constituent in teeth and bones) or as accessory minerals in igneous rocks (Monazite, Xenotime).</skos:definition>
	<skos:example xml:lang="en">phosphorite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">phosphate minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Phosphatmineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minéraux de phosphate</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerali di fosfato</skos:prefLabel>
	<skos:altLabel xml:lang="fr">phosphates</skos:altLabel>
	<skos:altLabel xml:lang="it">fosfati</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Apatite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Monazite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Xenotime"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Apatite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Apatite is a calcium phosphate mineral (mostly F-bearing fluorapatite). It is typically found as an accessory mineral in alcaline magmatic rocks and metamorphosed limestones. It canalso occur as a cryptocrystalline variety (Collophanite) in sedimentary rocks, derived from epigenetised bone or teeth material.</skos:definition>
	<skos:example xml:lang="en">phosphorite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">apatite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Apatit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">apatite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">apatite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">collophane</skos:hiddenLabel>
	<skos:notation>Ap</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phosphateminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-29229html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Monazite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Monazite is a group of accessory phosphate minerals. It is typically rich in REE and It can be used for radiometric datations as it usually contains small amounts of Th and U.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">monazite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Monazit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">monazite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">monazite</skos:prefLabel>
	<skos:notation>Mnz</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phosphateminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2750html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Xenotime">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Xenotime is an accessory phosphate mineral that can be used for radiometric dating of granites and pegmatites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">xenotime</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Xenotim</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">xénotime</skos:prefLabel>
	<skos:prefLabel xml:lang="it">xenotimo</skos:prefLabel>
	<skos:notation>Xtm</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phosphateminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-6613html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Silicateminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Silicates are a major group of rock-forming minerals whose crystalline structures are fundamently based on SiO4-tetrahedrons. They are classified according to their crystal structure.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">silicate minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Silikatmineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">silicates minéraux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">silicati</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminiumsilicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sorosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cyclosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Inosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Asbestos"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Calcsilicateminerals"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nesosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Nesosilicates have a crystalline structure based on isolated silicate anions.</skos:definition>
	<skos:definition xml:lang="fr">structure cristalline basée sur des tétraèdes isolés</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">nesosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Nesosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">nésosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">nesosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="en">orthosilicates</skos:altLabel>
	<skos:altLabel xml:lang="de">Inselsilikate</skos:altLabel>
	<skos:altLabel xml:lang="it">ortosilicati</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Olivine"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Garnet"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chloritoid"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Titanite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Topaz"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Zircon"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosubsilicates"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Olivine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Olivine designates a mineral group, mainly represented by the two end-members Fayalite (Fe-rich) and Forsterite (Mg-rich). It is typically found in mafi to ultramafic magmatic rocks (basalt, peridotite), as well as in high-grade magnesian marble.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">olivine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Olivin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">olivine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">olivina</skos:prefLabel>
	<skos:altLabel xml:lang="de">Olivingruppe</skos:altLabel>
	<skos:hiddenLabel xml:lang="fr">péridot</skos:hiddenLabel>
	<skos:notation>Ol</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fayalite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Forsterite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-29264html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Fayalite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Fayalite is an Iron-rich Olivine forming a series with its Mg-rich counterpart Forsterite. It is uncommon in nature.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">fayalite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Fayalit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">fayalite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">fayalite</skos:prefLabel>
	<skos:notation>Fa</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Olivine"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Forsterite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1458html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Forsterite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Forsterite is a Mg-rich Olivine forming a series with its Fe-rich counterpart Fayalite. It is typically found in mafic and ultramafic igneous rocks, as well as in metamorphosed impure dolomites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">forsterite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Forsterit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">forstérite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">forsterite</skos:prefLabel>
	<skos:notation>Fo</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Olivine"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fayalite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1584html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Garnet">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Garnet designates a relatively hard and dense nesosilicate mineral group. It is typically found in metamorphic rocks.</skos:definition>
	<skos:example xml:lang="en">micaschiste à grenat, éclogite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">garnet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Granat</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">grenat</skos:prefLabel>
	<skos:prefLabel xml:lang="it">granato</skos:prefLabel>
	<skos:altLabel xml:lang="en">garnet group</skos:altLabel>
	<skos:altLabel xml:lang="de">Granatgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des grenats</skos:altLabel>
	<skos:altLabel xml:lang="it">granati</skos:altLabel>
	<skos:notation>Grt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyralspite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ugrandite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-10272html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pyralspite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pyralspite groups together the aluminous garnets Pyrope (Mg-rich, blood-red), Almandine (Fe-rich, reddish brown) and Spessartite (Mn-rich, yellowish to light redish brown).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pyralspite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pyralspit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pyralspite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">piralspite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">grenats alumineux non calciques</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Garnet"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrope"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Almandine"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Spessartite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-27257html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pyrope">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pyrope is a blood-red-coloured magnesium-aluminium garnet forming a series with Almandine and Spessartite. It is typically found in ultrabasic rocks (peridotite, kimberlite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pyrope</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pyrop</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pyrope</skos:prefLabel>
	<skos:prefLabel xml:lang="it">piropo</skos:prefLabel>
	<skos:notation>Prp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyralspite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Almandine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3321html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Almandine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Almandine is a brown to red iron-aluminium garnet forming series with both Pyrope and Spessartine. It is typically found in metamorphosed sedimentary and magmatic rocks (micaschist, paragneiss, orthogneiss, eclogite), as well as in pegmatitic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">almandine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Almandin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">almandin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">almandino</skos:prefLabel>
	<skos:notation>Alm</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyralspite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrope"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Spessartine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-452html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Spessartite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Spessartite is a yellowish to light brownish red manganese-aluminium garnet forming a series with Almadine and Pyrope. It is typically found in hyperaluminous silicium-saturated magmatic rocks (granite, pegmatite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">spessartite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Spessartin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">spessartite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">spessartina</skos:prefLabel>
	<skos:notation>Sps</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyralspite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Almandine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3725html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ugrandite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Ugrandite groups together the calcic garnets Uvarovite (Cr-rich, emerald green), Grossular (Al-rich, colourless) and Andradite (Fe-rich, yellow to dark green or black).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">ugrandite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Urandit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ougrandite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ugrandite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">ugrandite</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Garnet"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Uvarovite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andradite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Grossular"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4079html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Uvarovite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Uvarovite is a chromium-rich calcic garnet typically found in metamorphosed limestones and skarns. It also forms as an hydrothermal alteration product of chromite-bearing serpentinite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">uvarovite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Uwarowit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">uvarovite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">uvarovite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">ouvarovite</skos:hiddenLabel>
	<skos:notation>Uv</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ugrandite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andradite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Grossular"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4125html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Andradite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Andradite is a iron-rich calcic garnet forming continuous series with both Grossular and Uvarovite. It is found in skarns (contact metamorphosed impure limestones), as well as in chlorite schists and serpentinites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">andradite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Andradit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">andradite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">andradite</skos:prefLabel>
	<skos:notation>Adr</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ugrandite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Uvarovite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Grossular"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-223html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Grossular">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Grossular is an aluminium-rich calcic garnet typically found in contact and regionally metamorphosed calcareous rocks, as well as in rodingite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">grossular</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Grossular</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">grossulaire</skos:prefLabel>
	<skos:prefLabel xml:lang="it">grossularia</skos:prefLabel>
	<skos:notation>Grs</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ugrandite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Uvarovite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andradite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1755html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chloritoid">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chloritoid is a silicate mineral group characteristic of metapelitic rocks of the greenschist facies.</skos:definition>
	<skos:example xml:lang="en">schiste à chloritoïde (Suretta-Decke)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chloritoid</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chloritoid</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chloritoïde</skos:prefLabel>
	<skos:prefLabel xml:lang="it">cloritoide</skos:prefLabel>
	<skos:notation>Cld</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1017html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Titanite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Titanite (also known as Sphene) is a calcium titanium silicated typically found as an accessory mineral in igneous and metamorphic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">titanite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Titanit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">titanite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">titanite</skos:prefLabel>
	<skos:altLabel xml:lang="en">sphene</skos:altLabel>
	<skos:altLabel xml:lang="de">Sphen</skos:altLabel>
	<skos:altLabel xml:lang="fr">sphène</skos:altLabel>
	<skos:notation>Ttn</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3977html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Topaz">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Topaz is a nesosilicate mineral typically found in pegmatites and high-temperature quartz veins.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">topaz</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Topaz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">topaze</skos:prefLabel>
	<skos:prefLabel xml:lang="it">topazio</skos:prefLabel>
	<skos:notation>Tpz</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3996html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Zircon">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Zircon is an accessory silicate mineral commonly used for radiometric dating (thanks to its high U content), as well as granite classification (based on its morpholoby).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">zircon</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Zirkon</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">zircon</skos:prefLabel>
	<skos:prefLabel xml:lang="it">zircone</skos:prefLabel>
	<skos:notation>Zrn</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4421html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nesosubsilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Nesosubsilicates form an informal mineral group related to nesosilicates, but with additional anions.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">nesosubsilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Nesosubsilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">nesosubsilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">nesosubsilicati</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Staurolite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Humite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Aluminiumsilicateminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In its restricted sense, the name Aluminosilicate designates Al2SiO5 polymorphs (Andalusite, Sillimanite and Kyanite), whereas in a broader acception (i.e. minerals containing aluminium, silicon and oxygen) it also encompasses feldspars, micas and zeolites.</skos:definition>
	<skos:definition xml:lang="fr">Les silicates d'alumines, de formule Al2SiO5, sont formés de tétraèdres SiO4 unis entre eux par des atomes d'aluminium.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">aluminium-silicate minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aluminium-Silikat-Mineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minéraux alumino-silicatés</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerali alumino-silicati</skos:prefLabel>
	<skos:altLabel xml:lang="en">aluminium silicates, silicates of Aluminium</skos:altLabel>
	<skos:altLabel xml:lang="fr">silicates d'aluminium</skos:altLabel>
	<skos:altLabel xml:lang="it">silicati di aluminium</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Aluminosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In its restricted sense, the name Aluminosilicate designates Al2SiO5 polymorphs (Andalusite, Sillimanite and Kyanite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">aluminosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Alumosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">silicates d'alumines</skos:prefLabel>
	<skos:prefLabel xml:lang="it">aluminosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="de">Aluminosilikate</skos:altLabel>
	<skos:altLabel xml:lang="fr">aluminosilicates</skos:altLabel>
	<skos:notation>Als</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosubsilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andalusite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Kyanite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sillimanite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-55563html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Andalusite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Andalusite is the low-pressure and low-temperature form of Al2SiO4 typically found in regionally metamorphosed hyperaluminous rocks such as schists and argillaceous sediments affected by contact metamorphism.</skos:definition>
	<skos:definition xml:lang="en">Andalusite is the low-pressure and low-temperature form of Al2SiO4 typically found in regionally metamorphosed schists and argillaceous sediments affected by contact metamorphism.</skos:definition>
	<skos:example xml:lang="en">schiste à andalousite et cordiérite (Cavloccio)</skos:example>
	<skos:example xml:lang="en">schiste à andalousite et cordiérite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">andalusite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Andalusit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">andalousite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">andalusite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">chiastolite variety</skos:altLabel>
	<skos:notation>And</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminosilicates"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Kyanite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sillimanite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-217html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Kyanite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Kyanite is the moderately high-pressure form of Al2SiO4 typically found in regionally metamorphosed schists.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">kyanite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kyanit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">disthène</skos:prefLabel>
	<skos:prefLabel xml:lang="it">cianite</skos:prefLabel>
	<skos:altLabel xml:lang="en">disthene</skos:altLabel>
	<skos:altLabel xml:lang="de">Disthen</skos:altLabel>
	<skos:altLabel xml:lang="it">distene</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">cyanite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Cyanit</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">kyanite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">kyanite</skos:hiddenLabel>
	<skos:notation>Ky</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminosilicates"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andalusite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sillimanite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2303html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sillimanite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sillimanite is the high-pressure and high-temperature form of Al2SiO4 typically found in regionally metamorphosed schists, as well as in thermal aureoles around intrusive rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sillimanite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sillimanit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sillimanite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sillimanite</skos:prefLabel>
	<skos:notation>Sil</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aluminosilicates"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andalusite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Kyanite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3662html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Staurolite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Staurolite is an hydrated Fe-Al nesosilicate typically found in pelitic rocks metamorphosed under amphibolite-grade conditions.</skos:definition>
	<skos:example xml:lang="en">(Alpine Metamorphose de südliche Tambo-Decke, ältere Metamorphose bei der Suretta-Decke)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">staurolite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Staurolith</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">staurolite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">staurolite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">staurotide</skos:altLabel>
	<skos:notation>St</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosubsilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3753html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Humite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Humite is a complex mineral group structurally related to the olivine group. It is typically found in regionally metamorphosed limesonte, dolostone and peridotite, as well as in calc-silicate rocks and skarns.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">humite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Humit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">humite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">humite</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nesosubsilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-29252html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sorosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sorosilicates have a crystalline structure based on pairs of silicate anions.</skos:definition>
	<skos:definition xml:lang="fr">structure cristalline basée sur des tétraèdes liés par paires</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sorosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sorosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sorosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sorosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="de">Gruppensilikate</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Epidote"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Lawsonite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pumpellyite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Vesuvianite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Epidote">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Epidote designates a sorosilicate mineral group. It is typically found in metamorphic rocks, especially as an alteration product (saussuritisation) of Plagioclase.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">epidote</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Epidot</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">épidote</skos:prefLabel>
	<skos:prefLabel xml:lang="it">epidoto</skos:prefLabel>
	<skos:altLabel xml:lang="en">epidote group</skos:altLabel>
	<skos:altLabel xml:lang="de">Epidotgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des épidotes</skos:altLabel>
	<skos:altLabel xml:lang="it">epidoti</skos:altLabel>
	<skos:notation>Ep</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sorosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Allanite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinozoisite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Zoisite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1389html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Allanite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Allanite is an member of the epidote mineral group, characteristically rich in rare earth elements (REE). It is typically found as an accessory mineral in granite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">allanite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Allanit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">allanite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">allanite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">orthite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Orthit</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">orthite</skos:hiddenLabel>
	<skos:notation>Aln</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Epidote"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-46220html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Clinozoisite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Clinozoisite is a mineral of the Epidote group, dimorph with Zoisite. It is typically found in metamorphic and metasomatic rocks where it forms by hydrothermal alteration of plagioclase (saussuritisation).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">clinozoisite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Klinozoisit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">clinozoïsite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">clinozoisite</skos:prefLabel>
	<skos:notation>Czo</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Epidote"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Zoisite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1087html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Zoisite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Zoisite, formerly considered as a member of the epidote group, is now classified together with its polymorph Clinozoisite. It is typically found in medium grade regionally metamorphosed rocks, as well as in eclogitic and blueschist facies metamorphic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">zoisite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Zoisit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">zoïsite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">zoisite</skos:prefLabel>
	<skos:notation>Zo</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Epidote"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinozoisite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4430html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Lawsonite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Lawsonite is a high-pressure low-temperature metamorphic mineral typically found in glaucophane schists and as alteration product (saussuritisation) of gabbros and diabases.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">lawsonite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lawsonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">lawsonite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">lawsonite</skos:prefLabel>
	<skos:notation>Lws</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sorosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2353html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pumpellyite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pumpellyite is an hydrated Ca-Al silicate mineral group.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pumpellyite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pumpellyit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pumpellyite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">pumpellyite</skos:prefLabel>
	<skos:notation>Pmp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sorosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3305html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Vesuvianite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Vesuvianite is sorosilicate mineral typically found in skarns or regionally metamorphed limestones.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">vesuvianite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Vesuvianit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">vésuvianite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">vesivuanite</skos:prefLabel>
	<skos:altLabel xml:lang="en">idocrase</skos:altLabel>
	<skos:altLabel xml:lang="de">Idokras</skos:altLabel>
	<skos:altLabel xml:lang="fr">idocrase</skos:altLabel>
	<skos:altLabel xml:lang="it">idocrasio</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Vesuvian</skos:hiddenLabel>
	<skos:notation>Ves</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sorosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4223html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Cyclosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Cyclosilicates have a crystalline structure based on rings of silicate anions.</skos:definition>
	<skos:definition xml:lang="fr">structure cristalline basée sur des tétraèdes formant des anneaux fermés</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">cyclosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Cyclosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">cyclosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ciclosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="en">ring silicates</skos:altLabel>
	<skos:altLabel xml:lang="de">Ringsilikate</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Beryl"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cordierite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tourmaline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Beryl">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Beryl is a beryllium-aluminium-silicate mineral. It is typically (but rarely) found in granitic pegmatites.</skos:definition>
	<skos:example xml:lang="en">Pegmatites of the Bregaglia Intrusion</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">beryl</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Beryll</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">béryl</skos:prefLabel>
	<skos:prefLabel xml:lang="it">berillo</skos:prefLabel>
	<skos:altLabel xml:lang="en">emerald, aquamarine</skos:altLabel>
	<skos:altLabel xml:lang="fr">béril, émeraude, aigue-marine</skos:altLabel>
	<skos:notation>Brl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gemstones"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cyclosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-819html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Cordierite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Cordierite is a high- to ultrahigh-temperature mineral species. It is typically found in contact and regional metarmorphic rocks, in particular under low pressure granulitic facies (subsequently altered to Pinite), as well as in migmatitic gneisses and anatectic granites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">cordierite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Cordierit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">cordiérite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">cordierite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">dichroïte</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Dichroit</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">dicroite</skos:hiddenLabel>
	<skos:notation>Crd</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cyclosilicates"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pinite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1128html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pinite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pinite is an informal generic name for fine-grained pseudomorphs of diverse aluminosilicate minerals (cordierite, nepheline, topaz, andalusite, spodumene, feldspars and scapolite). It is primarily composed of sericite mica and may include some clay group minerals.</skos:definition>
	<skos:example xml:lang="en">Murtaira</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pinite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pinit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pinite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">pinite</skos:prefLabel>
	<skos:altLabel xml:lang="en">pinnite</skos:altLabel>
	<skos:altLabel xml:lang="de">Pinnit</skos:altLabel>
	<skos:altLabel xml:lang="fr">pinnite</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sericite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cordierite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-9410html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Tourmaline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Tourmaline designates a diverse borosilicate mineral group found in acidic igenous, metasomatic and metamorphic rocks (granite, pegmatite, greisen, hornfels, schist).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">tourmaline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Turmalin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">tourmaline</skos:prefLabel>
	<skos:prefLabel xml:lang="it">tormalina</skos:prefLabel>
	<skos:altLabel xml:lang="de">Turmalingruppe</skos:altLabel>
	<skos:notation>Tur</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Gemstones"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Cyclosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4003html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Inosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Inosilicates have a crystalline structure based on single (Pyroxene) or double (Amphibole) straight chains of silicate anions.</skos:definition>
	<skos:definition xml:lang="fr">structure cristalline basée sur des tétraèdes formant des chaînes simples ou doubles (rubans)</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">inosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Inosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">inosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">inosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="en">single chain silicates</skos:altLabel>
	<skos:altLabel xml:lang="de">Kettensilikate</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyroxene"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Wollastonite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sapphirine"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Carpholite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Amphibole"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pyroxene">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pyroxene designates a large group of chain silicates.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pyroxene</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pyroxen</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pyroxène</skos:prefLabel>
	<skos:prefLabel xml:lang="it">pirosseno</skos:prefLabel>
	<skos:altLabel xml:lang="en">pyroxene group</skos:altLabel>
	<skos:altLabel xml:lang="de">Pyroxengruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">group des pyroxènes</skos:altLabel>
	<skos:altLabel xml:lang="it">pirosseni</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Inosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthopyroxene"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-9767html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Orthopyroxene">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Orthopyroxene subgroup encompasses orthorhombic Pyroxenes (most commonly Enstatite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">orthopyroxene</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Orthopyroxen</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">orthopyroxène</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ortopirosseno</skos:prefLabel>
	<skos:altLabel xml:lang="en">orthorhombic pyroxene</skos:altLabel>
	<skos:altLabel xml:lang="de">orthorhombischer Pyroxen</skos:altLabel>
	<skos:altLabel xml:lang="fr">pyroxène orthorhombique</skos:altLabel>
	<skos:altLabel xml:lang="it">pirosseno rombico</skos:altLabel>
	<skos:notation>Opx</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyroxene"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Enstatite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ferrosilite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Hypersthene"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-10967html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Enstatite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Enstatite is a Magnesium-rich Orthopyroxene forming a series with Ferrosilite. It is typically found in mafic magmatic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">enstatite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Enstatit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">enstatite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">enstatite</skos:prefLabel>
	<skos:notation>En</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthopyroxene"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ferrosilite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1384html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Ferrosilite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Ferrosilite is an Iron-rich Orthopyroxene forming a series with Enstatite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">ferrosilite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ferrosilit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ferrosilite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ferrosilite</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthopyroxene"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Enstatite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1528html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Hypersthene">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Hyperstheme is an informal name for a mid-way member of the Enstatite-Ferrosilite series (mostly ferroan enstatite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">hypersthene</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hypersthen</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">hypersthène</skos:prefLabel>
	<skos:prefLabel xml:lang="it">iperstene</skos:prefLabel>
	<skos:notation>Hyp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthopyroxene"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Enstatite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ferrosilite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1995html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Clinopyroxene subgroup encompasses monoclinic Pyroxenes rich in calcium (Diopside, Augite) or rich in sodium (Aegirine, Jadeite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">clinopyroxene</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Klinopyroxen</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">clinopyroxène</skos:prefLabel>
	<skos:prefLabel xml:lang="it">clinopirosseno</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Clinopyroxen</skos:hiddenLabel>
	<skos:notation>Cpx</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyroxene"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Augite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aegirine"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Diopside"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Jadeite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Omphacite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-7630html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Augite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Augite is a black calcic and ferromagnesian clinopyroxene typically found in mafic to ultramafic igneous rocks, as well as some high-grade metamorphic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">augite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Augit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">augite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">augite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">augurite</skos:hiddenLabel>
	<skos:notation>Aug</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Aegirine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-419html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Aegirine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Aegirine is a sodic clinopyroxene typically formed in hypercalkaline rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">aegirine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aegirin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">aegirine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">egirina</skos:prefLabel>
	<skos:altLabel xml:lang="fr">aegyrine</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Ägirin</skos:hiddenLabel>
	<skos:notation>Aeg</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Augite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-31html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Diopside">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Diopside is one of the most common members of the Pyroxene group (Ca-Mg clinopyroxene). It is typically found in metamorphosed limestones (marbles, skarns), as well as in lherzolitic peridotites, gabbros and basalts.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">diopside</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Diopsid</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">diopside</skos:prefLabel>
	<skos:prefLabel xml:lang="it">diopside</skos:prefLabel>
	<skos:notation>Di</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1294html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Jadeite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Jadeite is an alacline clinopyroxene mineral typically found in high-pressure low-temperature metamorphic rocks, where it replaces Albite</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">jadeite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Jadeit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">jadéite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">giadeite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">nephrite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Nephrit</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">néphrite</skos:hiddenLabel>
	<skos:notation>Jd</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2062html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Omphacite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Omphacite is a high-pressure and high-temperature clinopyroxene mineral, which occurs as a primary constituent of eclogite, together with garnet.</skos:definition>
	<skos:example xml:lang="en">éclogite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">omphacite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Omphazit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">omphacite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">omfacite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Omphacit</skos:altLabel>
	<skos:notation>Omp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinopyroxene"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2991html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Wollastonite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Wollastonite is a calcsilicate (pyroxenoid) mineral typically found in thermally metamorphosed siliceous carbonates (e.g. skarn).</skos:definition>
	<skos:example xml:lang="en">In Switzerland, wollastonite is found in marbles of the contact metamorph aureole of the Bregaglia Intrusion (e.g. Vazzeda Marble, Murtaira).</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">wollastonite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Wollastonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">wollastonite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">wollastonite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Tafelspat</skos:hiddenLabel>
	<skos:notation>Wo</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Inosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4323html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sapphirine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sapphirine is a Mg-Al silicate mineral typically found in high-temperature metamorphic rocks or xenoliths.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sapphirine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sapphirin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">saphirine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">saffirina</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Saphirin</skos:hiddenLabel>
	<skos:notation>Spr</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Inosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3531html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Carpholite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Carpholite is an hydrated silicate of Manganese. It is typically found in low-grade metasedimentary rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">carpholite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Karpolith</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">carpholite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">carpholite</skos:prefLabel>
	<skos:notation>Car</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Inosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-909html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Amphibole">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Amphibole designates a large and complex mineral group, with ferromagnesian (Anthophyllite), calcic (Termolite-Actinolite, hornblendes) and/or sodic (Glaucophane) species.</skos:definition>
	<skos:example xml:lang="en">amphibolite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">amphibole</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Amphibol</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">amphibole</skos:prefLabel>
	<skos:prefLabel xml:lang="it">anfibolo</skos:prefLabel>
	<skos:altLabel xml:lang="en">amphibole group</skos:altLabel>
	<skos:altLabel xml:lang="de">Amphibolgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des amphiboles</skos:altLabel>
	<skos:altLabel xml:lang="it">anfiboli</skos:altLabel>
	<skos:notation>Amp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Inosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tremolite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Actinolite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Hornblende"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Glaucophane"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Uralite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-207html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Tremolite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Tremolite is a calcium amphibole mineral forming a continuous series with Actinolite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">tremolite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Tremolit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">trémolite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">tremolite</skos:prefLabel>
	<skos:notation>Tr</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Amphibole"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Actinolite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4011html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Actinolite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Actinolite is a pale green calcic and ferromagnesian amphibole mineral forming a continuous series with Tremolite. It serves as a metamorphic indicator of the actinolite-pumpellyite facies (greenschist facies).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">actinolite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aktinolith</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">actinolite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">actinolite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">actinote</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Strahlstein</skos:hiddenLabel>
	<skos:notation>Act</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Amphibole"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tremolite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-18html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Hornblende">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Hornblende is an informal name for dark green to brown or black calcic amphiboles.</skos:definition>
	<skos:example xml:lang="en">Hornblendeschiefer, amphibolite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">hornblende</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hornblende</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">hornblende</skos:prefLabel>
	<skos:prefLabel xml:lang="it">orneblenda</skos:prefLabel>
	<skos:altLabel xml:lang="de">Calcium-Amphibole</skos:altLabel>
	<skos:notation>Hbl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Amphibole"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1930html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Glaucophane">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Glaucophane is a blue-coloured sodic amphibole typically found in metamorphic rocks of the blueschist facies.</skos:definition>
	<skos:example xml:lang="en">schiste à glaucophane (et riebeckite) à Grevasalvas + Val Maroz</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">glaucophane</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Glaukophan</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">glaucophane</skos:prefLabel>
	<skos:prefLabel xml:lang="it">glaucofane</skos:prefLabel>
	<skos:notation>Gln</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Amphibole"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1704html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Uralite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Uralite is an alteration mineral belonging to the amphibole group. It occurs as a pseudomorph (uralitisation) of actinolite or augite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">uralite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Uralit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">ouralite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">uralite</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Amphibole"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4098html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Phyllosilicates have a crystalline structure based on sheets of silicate anions.</skos:definition>
	<skos:definition xml:lang="fr">structure cristalline basée sur des tétraèdes formant des feuillets plans</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">phyllosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Phyllosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">phyllosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">fillosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="en">sheet silicates</skos:altLabel>
	<skos:altLabel xml:lang="de">Schichtsilikate</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Blattsilikate</skos:hiddenLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Mica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Serpentine"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Stilpnomelane"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Prehnite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-471575html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Mica">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Mica designates a large phyllosilicate group with a TOT crystalline configuration rigidified by intercalatory potassium.</skos:definition>
	<skos:example xml:lang="en">micaschist, Zweiglimmergneis</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">mica</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Glimmer</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">mica</skos:prefLabel>
	<skos:prefLabel xml:lang="it">mica</skos:prefLabel>
	<skos:altLabel xml:lang="en">mica group</skos:altLabel>
	<skos:altLabel xml:lang="de">Glimmergruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des micas</skos:altLabel>
	<skos:altLabel xml:lang="it">miche</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Whitemica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Blackmica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Margarite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Lepidolite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Glauconite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-6728html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Whitemica">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">White mica is an informal generic name for light-coloured mica (i.e. muscovite, paragonite, pyrophyllite, margarite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">white mica</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hellglimmer</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">mica blanc</skos:prefLabel>
	<skos:prefLabel xml:lang="it">mica bianco</skos:prefLabel>
	<skos:altLabel xml:lang="fr">micas alumineux, micas dioctaédriques</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Mica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Muscovite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sericite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Paragonite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-46861html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Muscovite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Muscovite is the most common dioctahedral mica that can be found in a large variety of rocks (igneous, metamorphic and sedimentary).</skos:definition>
	<skos:example xml:lang="en">Muskovitgneis</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">muscovite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Muskovit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">muscovite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">muscovite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Muskowit</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">potash mica</skos:hiddenLabel>
	<skos:notation>Ms</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Whitemica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phengite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Illite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Fuchsite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2815html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Phengite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Phengite is a variety of Muscovite. It is typically found in metamorphic rocks such as schist and gneiss.</skos:definition>
	<skos:example xml:lang="en">Phengitgneis</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">phengite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Phengit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">phengite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">fengite</skos:prefLabel>
	<skos:notation>Ph</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Muscovite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3189html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sericite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sericite is a fine-grained white mica (mainly Muscovite, rarely Paragonite). It is typically found in metamorphic rocks such as schist, gneiss and impure marble.</skos:definition>
	<skos:example xml:lang="en">Serizitschiefer, Serizitmarmor</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sericite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Serizit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">séricite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sericite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Sericit</skos:hiddenLabel>
	<skos:notation>Ser</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Whitemica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pinite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-9252html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Illite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Illite is a three-layers, non-swelling Clay Mineral group (also considered an extremely fine-grained variety of Muscovite) with a moderate cation-exchange capacity. It is an indicator of very low-grade metamorphism in pelitic rocks (illite crystallinity index).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">illite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Illit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">illite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">illite</skos:prefLabel>
	<skos:notation>Ilt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Muscovite"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phengite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2011html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Clayminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Clay minerals are a group of hydrous aluminium phyllosilicates, composed of layered sheets of silicate tetrahedra (T) and aluminium octahedra (O). They are typically found in sedimentary rocks, as well as in hydrothermally altered or weathered (incl. soils) rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">clay minerals</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Tonmineralien</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">minéraux argileux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">minerali argillosi</skos:prefLabel>
	<skos:altLabel xml:lang="fr">argiles minérales</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Illite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Kaolinite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Talc"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrophyllite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Smectite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Vermiculite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chlorite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1062html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Paragonite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Paragonite is an uncommon Na-bearing dioctahedral mica typically found in low- to medium-grade metamorphic schists and phyllites, as well as in two-mica gneiss.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">paragonite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Paragonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">paragonite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">paragonite</skos:prefLabel>
	<skos:notation>Pr</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Whitemica"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3090html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Fuchsite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Fuchsite is a greenish, Cr-bearing variety of Muscovite typically found in metamorphosed ultrabasic rocks.</skos:definition>
	<skos:example xml:lang="en">Piz Lizun, Juferhorn</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">fuchsite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Fuchsit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">fuchsite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">fuchsite</skos:prefLabel>
	<skos:altLabel xml:lang="en">chrome mica</skos:altLabel>
	<skos:altLabel xml:lang="fr">mica chromifère</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">fuxite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Fuxit</skos:hiddenLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Muscovite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1617html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Blackmica">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Black Mica is a generic name for dark-coloured, ferromagnesian trioctahedral micas (mainly belonging to the biotite series).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">black mica</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Dunkelglimmer</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">mica noir</skos:prefLabel>
	<skos:prefLabel xml:lang="it">mica nero</skos:prefLabel>
	<skos:altLabel xml:lang="en">dark-coloured mica, dark mica</skos:altLabel>
	<skos:altLabel xml:lang="fr">micas ferromagnésiens</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Mica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Biotite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Siderophyllite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Biotite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Biotite is generic name for dark-coloured, ferromagnesian trioctahedral micas. It commonly alters to Chlorite or Vermiculite.</skos:definition>
	<skos:scopeNote xml:lang="en">Biotite (s.l.) is sometimes considered a synonym of Black Mica.</skos:scopeNote>
	<skos:example xml:lang="en">Biotitgranit</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">biotite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Biotit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">biotite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">biotite</skos:prefLabel>
	<skos:notation>Bt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Blackmica"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Annite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phlogopite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Annite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phlogopite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-677html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Annite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Annite is a dark-coloured mica of the Biotite series (where it represents the Fe analogue to Phlogopite). It is found in igneous and metamorphic rocks with low Mg content (syenite and granite of the alcaline series).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">annite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Annit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">annite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">annite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Orthit</skos:hiddenLabel>
	<skos:notation>Ann</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Biotite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Biotite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-241html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Phlogopite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Phlogopite is a dark-coloured mica of the Biotite series (where it represents the Mg analogue to Annite). It is typically found in dolomitic marbles in association with Spinel and Diopside.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">phlogopite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Phlogopit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">phlogopite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">flogopite</skos:prefLabel>
	<skos:notation>Phl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Biotite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Biotite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3193html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Siderophyllite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Siderophyllite is an iron-rich dark-coloured mica.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">siderophyllite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Siderophyllit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sidérophylite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">siderofilite</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Blackmica"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3651html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Margarite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Margarite is a calcium-rich mica, rarely found in some metamorphic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">margarite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Margarit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">margarite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">margarite</skos:prefLabel>
	<skos:altLabel xml:lang="en">brittle mica</skos:altLabel>
	<skos:altLabel xml:lang="fr">mica dur</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Periglimmer</skos:hiddenLabel>
	<skos:notation>Mrg</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Mica"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2573html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Lepidolite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Lepidolite is a lithium-rich mica, with rare local occurrences in pegmatites and hydrothermal veins.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">lepidolite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lepidolit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">lépidolite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">lepidolite</skos:prefLabel>
	<skos:altLabel xml:lang="en">lithium mica</skos:altLabel>
	<skos:altLabel xml:lang="fr">mica lithinifère</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Mica"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2380html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Glauconite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Glauconite is a green-coloured complex mineral often considered as a mica, but that can also correspond to a mixture of mica, serpentine and chlorite.</skos:definition>
	<skos:example xml:lang="en">grès glauconieux</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">glauconite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Glaukonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">glauconite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">glauconite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">glauconie</skos:hiddenLabel>
	<skos:notation>Glt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Mica"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1710html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Serpentine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Serpentine designates a Mg-rich phyllosilicate mineral group. It is the major consitutent of the rock serpentinite.</skos:definition>
	<skos:example xml:lang="en">serpentinite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">serpentine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Serpentin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">serpentine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">serpentino</skos:prefLabel>
	<skos:altLabel xml:lang="en">serpentine group</skos:altLabel>
	<skos:altLabel xml:lang="de">Serpentingruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des serpentines</skos:altLabel>
	<skos:notation>Srp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Antigorite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chrysotile"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Lizardite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-11135html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Antigorite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Antigorite is a high temperature lamellar to masive serpentine mineral (forming only above 250°C, with Chrysotile and Lizardite as lower temperature polymorphs). It is typically found in serpentinised peridotitic rocks. The type material was collected from outcrops of the Geisspfad Serpentinite (Valle Antigorio, at the border between Switzerland and Italy).</skos:definition>
	<skos:definition xml:lang="en">Antigorite is a high temperature serpentine mineral (forming only above 250°C, with Chrysotile and Lizardite as lower temperature polymorphs). It is typically found in serpentinised peridotitic rocks. The type material was collected from outcrops of the Geisspfad Serpentinite (Valle Antigorio, at the border between Switzerland and Italy).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">antigorite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Antigorit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">antigorite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">antigorite</skos:prefLabel>
	<skos:altLabel xml:lang="de">Blätterserpentin</skos:altLabel>
	<skos:altLabel xml:lang="de">Blätterserpentin, Zermattit</skos:altLabel>
	<skos:notation>Atg</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Serpentine"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chrysotile"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Lizardite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-260html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chrysotile">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chrysotile is a low-temperature fibrous serpentine mineral, polymorphous with Lizardite and the higher temperature Antigorite.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chrysotile</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chrysotil</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chrysotile</skos:prefLabel>
	<skos:prefLabel xml:lang="it">crisotilo</skos:prefLabel>
	<skos:altLabel xml:lang="en">white asbestos</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Faserserpentin</skos:hiddenLabel>
	<skos:notation>Ctl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Serpentine"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Antigorite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Lizardite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-975html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Lizardite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Lizardite is a the most common mineral among the serpentine group. It is typically found as a retrograde metamorphic product replacing olivine and orthopyroxene in ultramafic igneous rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">lizardite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lizardit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">lizardite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">lizardite</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Serpentine"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Antigorite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2425html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Kaolinite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Kaolinite is a white two-layers, non-swelling Clay Mineral group with a low cation-exchange capacity. It is typically found as an alteration product (kaolinitisation) of feldspar-bearing rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">kaolinite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kaolinit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">kaolininite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">caolinite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">kaolin</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Kaolin</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">kaolin</skos:hiddenLabel>
	<skos:notation>Kln</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2156html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Talc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Talc is a phyllosilicate mineral typically formed through hydrothermal alteration of mafic rocks (talcschis, steatite), as well as in siliceous dolomites metamorphosed under low-temperature conditions.</skos:definition>
	<skos:example xml:lang="en">Talkschiefer</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">talc</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Talk</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">talc</skos:prefLabel>
	<skos:prefLabel xml:lang="it">talco</skos:prefLabel>
	<skos:notation>Tlc</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pyrophyllite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3875html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Pyrophyllite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Pyrophyllite is a phyllosilicate mineral typically found in hydrothermal veins and regionally metamorphosed schists.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">pyrophyllite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pyrophyllit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">pyrophyllite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">pirofillite</skos:prefLabel>
	<skos:notation>Prl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Talc"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3323html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Smectite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Smectite is a three-layers Clay Mineral group with a high cation-exchange capacity and a swelling propension in presence of water (and conversely shrinking when drying), which is important to consider for soil mechanics and geotechnics.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">smectite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Smektit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">smectite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">smectite</skos:prefLabel>
	<skos:altLabel xml:lang="en">smectite group</skos:altLabel>
	<skos:altLabel xml:lang="de">Smektitgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des smectites</skos:altLabel>
	<skos:altLabel xml:lang="it">smectiti</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Smectit</skos:hiddenLabel>
	<skos:notation>Sme</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Montmorillonite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-11119html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Montmorillonite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Montmorillonite is a Clay Mineral of the Smectite group with a high cation-exchange capacity and a swelling propension in presence of water (and conversely shrinking when drying), which is important to consider for soil mechanics and geotechnics. It is typical found as an hydrothermal alteration product of mafic volcanic rocks (ashes and glass) forming bentonite deposits.</skos:definition>
	<skos:example xml:lang="en">bentonite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">montmorillonite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Montmorillonit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">montmorillonite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">montmorillonite</skos:prefLabel>
	<skos:notation>Mnt</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Smectite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2821html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Vermiculite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Vermiculite is a Clay Mineral group formed by the alteration (weathering or hydrothermalism) of biotite or phlogopite in mafic to ultramafic rocks. It has a swelling propension through heating, wich important to consider for soil mechanics and geotechnics.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">vermiculite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Vermikulit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">vermiculite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">vermiculite</skos:prefLabel>
	<skos:notation>Vrm</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4170html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chlorite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chlorite is a three-layers, non-swelling Clay Mineral group with a moderate cation-exchange capacity. It is typically found in metamorphic rocks of greenschist facies, and as an alteration product of mafic minerals (Biotite, Orthopyroxene, Cordierite).</skos:definition>
	<skos:example xml:lang="en">Chloritschiefer, chloritoschiste</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chlorite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chlorit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chlorite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">clorite</skos:prefLabel>
	<skos:altLabel xml:lang="en">chlorite group</skos:altLabel>
	<skos:altLabel xml:lang="de">Chloritgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des chlorites</skos:altLabel>
	<skos:altLabel xml:lang="it">cloriti</skos:altLabel>
	<skos:notation>Chl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clayminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chamosite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinochlore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1016html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chamosite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chamosite is an Iron-rich mineral of the Chlorite group forming a series with Clinochlore. The type material was collected from outcrops of the Chamoson Iron Ore (Valais, Switzerland).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chamosite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chamosit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chamosite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">chamosite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">chamoisite</skos:hiddenLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ironore"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chlorite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Clinochlore"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-967html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Clinochlore">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Clinochlore is a Magnesium-rich mineral of the Chlorite group forming a series with Chamosite. It is typically found in metamorphic rocks of greenschist facies, and as an alteration product of mafic minerals (Biotite, Orthopyroxene, Cordierite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">clinochlore</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Klinochlor</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">clinochlore</skos:prefLabel>
	<skos:prefLabel xml:lang="it">clinoclore</skos:prefLabel>
	<skos:altLabel xml:lang="de">Clinochlor</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chlorite"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chamosite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1070html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Stilpnomelane">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Stilpnomelane is an hydrated K-Fe-Mg silicate mineral. It is typically found in metamorphic rocks of the blueschist and greenschist facies.</skos:definition>
	<skos:example xml:lang="en">Ostalpin (Julier-Granit)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">stilpnomelane</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Stilpnomelan</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">stilpnomélane</skos:prefLabel>
	<skos:prefLabel xml:lang="it">stilpnomelano</skos:prefLabel>
	<skos:notation>Stp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3789html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Prehnite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Prehnite is a relatively common hydrated Ca-Al silicate mineral typically found in low-temperature hydrothermal rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">prehnite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Prehnit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">prehnite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">prehnite</skos:prefLabel>
	<skos:altLabel xml:lang="fr">préhnite</skos:altLabel>
	<skos:notation>Prh</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Phyllosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3277html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Tectosilicates">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Tectosilicates have a crystalline structure based on a framework of alumosilicate anions.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">tectosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Tektosilikate</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">tectosilicates</skos:prefLabel>
	<skos:prefLabel xml:lang="it">tettosilicati</skos:prefLabel>
	<skos:altLabel xml:lang="en">framework silicates</skos:altLabel>
	<skos:altLabel xml:lang="de">Gerüstsilikate</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Quartz"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Coesite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Chalcedony"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Feldspar"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Feldspathoid"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Scapolite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Zeolite"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Quartz">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Quartz is one of the most common minerals with a wide range of varieties and colours. It is a significant component of many igneous, metamorphic and sedimentary rocks.</skos:definition>
	<skos:example xml:lang="en">quartzite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">quartz</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Quarz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">quartz</skos:prefLabel>
	<skos:prefLabel xml:lang="it">quarzo</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">cristal de roche</skos:hiddenLabel>
	<skos:notation>Qz</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Coesite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3337html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Coesite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Coesite is a high-pressure (&gt; 20 kbar) variant of SiO2 typical of impact rocks and some high-grade metamorphic rocks.</skos:definition>
	<skos:example xml:lang="en">quartzites du massif de Dora Maira</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">coesite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Coesit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">coésite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">coesite</skos:prefLabel>
	<skos:notation>Coe</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Quartz"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1104html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Chalcedony">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chalcedony (s.l.) designates microcrystalline to cryptocrystalline forms of quartz. It is typically found as chert nodules or beds (e.g. radiolarites, spiculites).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">chalcedony</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chalcedon</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">calcédoine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">calcedonio</skos:prefLabel>
	<skos:altLabel xml:lang="en">agate, jasper, chert</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-960html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Feldspar">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Feldspar designates a very common rock-forming tectosilicate mineral group, classically subdivided into two subgroups: Alkali feldspar and Plagioclase.</skos:definition>
	<skos:example xml:lang="en">arkose</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">feldspar</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Feldspat</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">feldspath</skos:prefLabel>
	<skos:prefLabel xml:lang="it">feldspato</skos:prefLabel>
	<skos:altLabel xml:lang="en">feldspar group</skos:altLabel>
	<skos:altLabel xml:lang="de">Feldspatgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des feldspaths</skos:altLabel>
	<skos:altLabel xml:lang="it">feldspati</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">felspar</skos:hiddenLabel>
	<skos:notation>Fsp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Plagioclase"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1624html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The alkali felspar subgroup forms a high temperature series from Sanidine to (high) Albite, characteristically poor in calcium and rich in potassium.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">alkali feldspar</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Alkalifeldspat</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">feldspath alcalin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">feldspato alcalino</skos:prefLabel>
	<skos:altLabel xml:lang="en">K-feldspar</skos:altLabel>
	<skos:altLabel xml:lang="de">Kalifeldspat</skos:altLabel>
	<skos:altLabel xml:lang="fr">feldspath potassique</skos:altLabel>
	<skos:altLabel xml:lang="it">feldspato potassico</skos:altLabel>
	<skos:notation>Afs / Kfs</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Feldspar"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Microcline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sanidine"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthoclase"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Anorthoclase"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Albite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-9581html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Microcline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Microcline is an alkali feldspar mineral, where is represents the fully-ordered, triclinil end-member. It is typically found in slowly cooled magmatic rocks (granite, pegmatite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">microcline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mikroklin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">microcline</skos:prefLabel>
	<skos:prefLabel xml:lang="it">microclino</skos:prefLabel>
	<skos:notation>Mc</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sanidine"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthoclase"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2704html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Sanidine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Sanidine is mineral of the alkali feldspar group. It is typically found in rapidly cooled magmatic rocks (rhyolite).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">sanidine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sanidin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">sanidine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sanidino</skos:prefLabel>
	<skos:notation>Sa</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Microcline"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthoclase"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3521html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Orthoclase">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Orthoclase is an alkali feldspar intermediate between Sanidine and Microcline. It is the most common alkali feldspar in most granitic rocks and also occurs in high-grade metamorphic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">orthoclase</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Orthoklas</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">orthose</skos:prefLabel>
	<skos:prefLabel xml:lang="it">ortoclasio</skos:prefLabel>
	<skos:altLabel xml:lang="fr">orthoclase</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Adular</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">adulaire</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">adularia</skos:hiddenLabel>
	<skos:notation>Or</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Adularia"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Microcline"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Sanidine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-3026html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Adularia">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Adularia is a variety of Orthoclase (alkali feldspar) typically found in low-temperature hydrothermal veins. The name derives from the Adula massif (Switzerland).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="de">Adular</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">adulaire</skos:prefLabel>
	<skos:prefLabel xml:lang="it">adularia</skos:prefLabel>
	<skos:prefLabel xml:lang="en">adularia</skos:prefLabel>
	<skos:notation>Adl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orthoclase"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-28html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Anorthoclase">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Anorthoclase (not to be confused with Anorthite nor Orthoclase) is a sodic-potasic member of the Albite-Sanidine series (Alkali Feldspar) with a K amount of 30% or less.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">anorthoclase</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Anorthoklas</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">anorthoclase</skos:prefLabel>
	<skos:prefLabel xml:lang="it">anortoclasio</skos:prefLabel>
	<skos:altLabel xml:lang="fr">anorthose</skos:altLabel>
	<skos:notation>Ano</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Albite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-248html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Albite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Albite is a sodic plagioclase feldspar forming a continuous series with Anorthite. It is also considered as an alkali feldspar.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">albite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Albit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">albite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">albite</skos:prefLabel>
	<skos:altLabel xml:lang="en">sodic feldspar</skos:altLabel>
	<skos:altLabel xml:lang="de">Natronfeldspat</skos:altLabel>
	<skos:altLabel xml:lang="fr">feldspath sodique</skos:altLabel>
	<skos:notation>Ab</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Alkalifeldspar"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Plagioclase"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Anorthite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-96html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Anorthite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Anorthite (not to be confused with Anorthoclase) is the Ca-rich end-member among plagioclase feldspars, forming a continuous series with Albite. It is found in mafic plutonic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">anorthite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Anorthit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">anorthite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">anortite</skos:prefLabel>
	<skos:notation>An</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Plagioclase"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/materialDescription/Albite"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-246html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Plagioclase">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Plagioclase (Albite-Anorthite Series) is an important rock-forming mineral group in magmatic and metamorphic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">plagioclase</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Plagioklas</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">plagioclase</skos:prefLabel>
	<skos:prefLabel xml:lang="it">plagioclasio</skos:prefLabel>
	<skos:notation>Pl</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Feldspar"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Albite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Anorthite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Oligoclase"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Andesine"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-9264html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Oligoclase">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Oligoclase is a plagioclase feldspar with and Albite:Anorthite ratio of 90:10 to 70:30 (hence also sometimes considered as a variety of Albite). It is typically found in felsic plutonic and volcanic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">oligoclase</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Oligoklas</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">oligoclase</skos:prefLabel>
	<skos:prefLabel xml:lang="it">oligoclasio</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Plagioclase"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2976html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Andesine">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Andesine is a sodic plagioclase feldspar with an Albite/Anorthite ratio of 70-50% (hence sometimes considered a variety of Albite). It is found in igneous rocks with intermediate silica content (syenite, andesite), as well as in metamorphic rocks of granulite to amphibolite facies.</skos:definition>
	<skos:example xml:lang="en">andésite</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">andesine</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Andesin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">andésine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">andesina</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">andesite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Andesit</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">andésite</skos:hiddenLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Plagioclase"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-220html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Feldspathoid">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Feldspathoid designates a group of rock-forming minerals typically found in igneous rocks that are undersaturated with respect to silica.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">feldspathoid</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Feldspatoid</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">feldspathoïde</skos:prefLabel>
	<skos:prefLabel xml:lang="it">feldspatoide</skos:prefLabel>
	<skos:altLabel xml:lang="en">feldspatoid, feldspathoid group, foid</skos:altLabel>
	<skos:altLabel xml:lang="de">Feldspatoide</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des feldspathoïdes</skos:altLabel>
	<skos:altLabel xml:lang="it">feldspatoidi</skos:altLabel>
	<skos:hiddenLabel xml:lang="de">Foide</skos:hiddenLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Leucite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Nepheline"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-47865html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Leucite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Leucite is a feldspathoid mineral typically found in high-K mafic and ultramafic volcanic rocks.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">leucite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Leucit</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">leucite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">leucite</skos:prefLabel>
	<skos:hiddenLabel xml:lang="de">Leuzit</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">leucolite</skos:hiddenLabel>
	<skos:notation>Lct</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Feldspathoid"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2465html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Nepheline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Nepheline is a K-bearing feldspathoid mineral typically found in silicium-undersaturated alkaline igneous rocks such as syenite.</skos:definition>
	<skos:example xml:lang="en">syénite à néphéline</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">nepheline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Nephelin</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">néphéline</skos:prefLabel>
	<skos:prefLabel xml:lang="it">nefelina</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">nephelite</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="fr">néphélite</skos:hiddenLabel>
	<skos:notation>Nph</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Feldspathoid"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-2880html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Scapolite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Scapolite designates a mineral group where Si-tetrahedrons are associated to carbonate, chloride and/or sulfate anions. It is typically found as a low-temperature metamorphic product in argillaceous carbonates and evaporites.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">scapolite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Skapolith</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">scapolite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">scapolite</skos:prefLabel>
	<skos:altLabel xml:lang="en">scapolite group</skos:altLabel>
	<skos:altLabel xml:lang="de">Skapolithgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">groupe des scapolites</skos:altLabel>
	<skos:notation>Scp</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-8778html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Zeolite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Zeolite designates a tectosilicate mineral group characteristically found in low temperature hydrothermal systems. It serves as indicator of the zeolite metamorphioc facies.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">zeolite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Zeolith</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">zéolite</skos:prefLabel>
	<skos:prefLabel xml:lang="it">zeolite</skos:prefLabel>
	<skos:altLabel xml:lang="en">zeolite group</skos:altLabel>
	<skos:altLabel xml:lang="de">Zeolithgruppe</skos:altLabel>
	<skos:altLabel xml:lang="fr">zéolithe</skos:altLabel>
	<skos:altLabel xml:lang="it">zeoliti</skos:altLabel>
	<skos:notation>Zeo</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Tectosilicates"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-4395html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Asbestos">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Mineralogically, Asbestos encompasses silicate minerals that have a highly fibrous (asbestiform) structure, mainly belonging to the amphibole and serpentine groups. Due to their heat resistance and chemical inertia these minerals have been commercially used despite their tendency to generate carcinogenic respirable dust.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">asbestos</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Asbest</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">amiante</skos:prefLabel>
	<skos:prefLabel xml:lang="it">amianto</skos:prefLabel>
	<skos:altLabel xml:lang="fr">asbeste</skos:altLabel>
	<skos:altLabel xml:lang="it">asbesto</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Industrialminerals"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-383html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Calcsilicateminerals">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Calcsilicate is a generic term for calcium-rich silicate minerals (mainly Wollastonite) and further compounds.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">calcsilicate</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kalksilikat</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">calcsilicate</skos:prefLabel>
	<skos:prefLabel xml:lang="it">calcefiro</skos:prefLabel>
	<skos:altLabel xml:lang="en">calcium silicate</skos:altLabel>
	<skos:altLabel xml:lang="fr">silicate de calcium</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Silicateminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-51217html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Metallicores">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Minerals"/>
