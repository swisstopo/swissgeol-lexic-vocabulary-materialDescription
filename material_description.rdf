	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Halideminerals"/>
	<skos:exactMatch rdf:resource="https://lexic.swissgeol.ch/materialDescription/Https//wwwmindatorg/min-1804html"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Fluorite">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Fluorite is a halide mineral (calcium fluoride, CaF2) typically found as a gangue mineral in hydrothermal veins (often associated with lead and zinc).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">fluorite</skos:prefLabel>
