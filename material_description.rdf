<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/MaterialDescription">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Materialdescription">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Geological materials (mostly unconsolidated deposits and rocks) are natural composite assemblages, whose components can be of very diverse colour, size, shape and nature, and which display a variety of more or less ordered mutual arrangement.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">material description</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Materialbeschreibung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">description matérielle</skos:prefLabel>
	<skos:prefLabel xml:lang="it">descrizione del materiale</skos:prefLabel>
	<skos:altLabel xml:lang="en">description of the material</skos:altLabel>
	<skos:altLabel xml:lang="de">Materiale Beschreibung</skos:altLabel>
	<skos:altLabel xml:lang="fr">description du matériel, description du matériau</skos:altLabel>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialProperty"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialComponents"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialFabric"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Colour">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The range of colours observed in geological materials is rather large, heterogeneous at different scales and often named subjectively. The present descriptive nomenclature is kept short on purpose in order to build a simple system for qualitative comparisons based on one basic colour name (hue or colour family), one modifying colour adjective (tint s.l., i.e. mixing with any basic colour) and an optional darkness/lightness indicator (shade or tint s.s., i.e. mixing with black, resp. white).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:topConceptOf rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">colour</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Farbe</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">couleur</skos:prefLabel>
	<skos:prefLabel xml:lang="it">colore</skos:prefLabel>
	<skos:altLabel xml:lang="en">color</skos:altLabel>
	<skos:altLabel xml:lang="fr">teinte</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Materialdescription"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Black"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Grey"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/White"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Beige"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Ochre"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Brown"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Red"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Orange"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Yellow"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Green"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Olive"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Blue"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Violet"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Magenta"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/Pink"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/Black">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:scopeNote xml:lang="en">Many very dark materials may appear black-coloured, but should rather be described according to their secondary apparent tint (or as a colour range with black as the darkest variant).</skos:scopeNote>
	<skos:example xml:lang="en">Pure black colour is particularly characteristic of coal deposits, basalt and obsidian. Among components, black colour is typical for ferromagnesian (pyroxene, amphibole) and oxide (magnetite) minerals, as well as tourmaline and onyx.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">black</skos:prefLabel>
	<skos:prefLabel xml:lang="de">schwarz</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">noir</skos:prefLabel>
	<skos:prefLabel xml:lang="it">nero</skos:prefLabel>
	<skos:altLabel xml:lang="en">pure black</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
</rdf:Description>

