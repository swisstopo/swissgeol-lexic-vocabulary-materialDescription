<rdf:Description rdf:about="https://lexic.swissgeol.ch/materialDescription/White">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:scopeNote xml:lang="en">Many very light materials may appear white-coloured or faintly grey-coloured, but should rather be described according to their secondary apparent tint (or as a colour range with white as the lightest variant).</skos:scopeNote>
	<skos:example xml:lang="en">Pure white colour is particularly characteristic of pure limestones (e.g. chalky micritic or oolitic limestone) and marbles (e.g. Carrara Marble), as well a pure quartzites. Among major components, white colour is typical for quartz and calcite (milky white to transparent), as well as feldspar.</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/materialDescription/MaterialDescription"/>
	<skos:prefLabel xml:lang="en">white</skos:prefLabel>
	<skos:prefLabel xml:lang="de">weiss</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">blanc</skos:prefLabel>
	<skos:prefLabel xml:lang="it">bianco</skos:prefLabel>
	<skos:altLabel xml:lang="en">pure white</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/materialDescription/Colour"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/White2yellow"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/materialDescription/White2pink"/>
</rdf:Description>

